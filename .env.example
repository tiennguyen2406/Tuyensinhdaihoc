# Docker requires the three secrets below. Generate new values; never copy DEV secrets.
POSTGRES_PASSWORD=
CATALOG_DB_PASSWORD=
CATALOG_CURSOR_SECRET=

# Optional Compose defaults are documented in README; leave blank to use them.
POSTGRES_USER=
POSTGRES_DB=
CATALOG_DB_USER=
API_PORT=
WEB_PORT=

# Native Python/Node runs only; Docker sets these service-local values itself.
POSTGRES_HOST=
POSTGRES_PORT=
API_INTERNAL_URL=
CRAWLER_RAW_DIR=
NEXT_TELEMETRY_DISABLED=

# Optional operator workflows: never provision these as part of ordinary app startup.
PUBLICATION_DB_USER=
PUBLICATION_DB_PASSWORD=
RELEASE_DB_USER=
RELEASE_DB_PASSWORD=
