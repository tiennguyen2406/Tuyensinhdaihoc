# Used by Docker Compose and the API. Set your own password in .env.
POSTGRES_PASSWORD=

# API defaults match the local PostgreSQL service in infra/compose.yaml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=tuyensinh
POSTGRES_DB=tuyensinhdaihoc

# Ignored raw blobs; alternatively use a private directory outside the checkout.
CRAWLER_RAW_DIR=state/raw

# Optional trusted local review/publisher login; keep unset until operator provisions roles.
# Credentials belong only in ignored .env or process environment.
PUBLICATION_DB_USER=
PUBLICATION_DB_PASSWORD=
