      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Hosts",
      "type": "array"
    },
    "allowed_document_hosts": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Document Hosts",
      "type": "array"
    },
    "seed_urls": {
      "items": {
        "format": "uri",
