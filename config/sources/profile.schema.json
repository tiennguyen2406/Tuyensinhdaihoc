      "title": "Source Locale",
      "type": "string"
    },
    "robots_policy": {
      "const": "obey",
      "default": "obey",
      "title": "Robots Policy",
      "type": "string"
    },
    "verified": {
      "default": false,
      "title": "Verified",
      "type": "boolean"
    }
