{
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "university_key": {
      "minLength": 1,
      "title": "University Key",
      "type": "string"
    },
