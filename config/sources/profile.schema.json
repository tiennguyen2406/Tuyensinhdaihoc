        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Seed Urls",
      "type": "array"
    },
    "years": {
      "items": {
        "enum": [
          2024,
          2025,
          2026
        ],
        "type": "integer"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Years",
      "type": "array"
    },
    "authority_scope": {
      "additionalProperties": {
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "type": "array"
      },
      "title": "Authority Scope",
      "type": "object"
    },
    "parser": {
      "minLength": 1,
      "title": "Parser",
      "type": "string"
    },
    "include_path_patterns": {
      "items": {
        "type": "string"
      },
      "title": "Include Path Patterns",
      "type": "array"
    },
    "exclude_path_patterns": {
      "items": {
        "type": "string"
      },
      "title": "Exclude Path Patterns",
      "type": "array"
    },
    "max_depth": {
      "default": 4,
      "maximum": 10,
      "minimum": 0,
      "title": "Max Depth",
      "type": "integer"
    },
    "max_discovery_urls": {
      "default": 5000,
      "exclusiveMinimum": 0,
      "title": "Max Discovery Urls",
      "type": "integer"
    },
    "max_query_variants_per_path": {
      "default": 20,
      "exclusiveMinimum": 0,
      "title": "Max Query Variants Per Path",
      "type": "integer"
    },
