{
  "$defs": {
    "ParserOptions": {
      "additionalProperties": false,
      "properties": {
        "html_content_selectors": {
          "items": {
            "type": "string"
          },
          "title": "Html Content Selectors",
          "type": "array"
        },
        "html_exclude_selectors": {
          "items": {
            "type": "string"
          },
          "title": "Html Exclude Selectors",
          "type": "array"
        }
      },
      "title": "ParserOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "university_key": {
      "minLength": 1,
      "title": "University Key",
      "type": "string"
    },
    "allowed_hosts": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Hosts",
      "type": "array"
    },
    "allowed_document_hosts": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Document Hosts",
      "type": "array"
    },
    "seed_urls": {
      "items": {
        "format": "uri",
        "maxLength": 2083,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Seed Urls",
      "type": "array"
    },
    "years": {
      "items": {
        "enum": [
          2024,
          2025,
          2026
        ],
        "type": "integer"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Years",
      "type": "array"
    },
    "authority_scope": {
      "additionalProperties": {
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "type": "array"
      },
      "title": "Authority Scope",
      "type": "object"
    },
    "parser": {
      "minLength": 1,
      "title": "Parser",
      "type": "string"
    },
    "parser_options": {
      "$ref": "#/$defs/ParserOptions"
    },
    "include_path_patterns": {
      "items": {
        "type": "string"
      },
      "title": "Include Path Patterns",
      "type": "array"
    },
    "exclude_path_patterns": {
      "items": {
        "type": "string"
      },
      "title": "Exclude Path Patterns",
      "type": "array"
    },
    "max_depth": {
      "default": 4,
      "maximum": 4,
      "minimum": 0,
      "title": "Max Depth",
      "type": "integer"
    },
    "max_discovery_urls": {
      "default": 5000,
      "exclusiveMinimum": 0,
      "title": "Max Discovery Urls",
      "type": "integer"
    },
    "max_query_variants_per_path": {
      "default": 20,
      "exclusiveMinimum": 0,
      "title": "Max Query Variants Per Path",
      "type": "integer"
    },
    "concurrency": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Concurrency",
      "type": "integer"
    },
    "requests_per_second": {
      "default": 0.5,
      "exclusiveMinimum": 0,
      "maximum": 0.5,
      "title": "Requests Per Second",
      "type": "number"
    },
    "max_burst": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Max Burst",
      "type": "integer"
    },
    "render_js": {
      "default": false,
      "title": "Render Js",
      "type": "boolean"
    },
    "source_locale": {
      "const": "vi_VN",
      "default": "vi_VN",
      "title": "Source Locale",
      "type": "string"
    },
    "robots_policy": {
      "const": "obey",
      "default": "obey",
      "title": "Robots Policy",
      "type": "string"
    },
    "verified": {
      "default": false,
      "title": "Verified",
      "type": "boolean"
    },
    "review_status": {
      "default": "candidate",
      "enum": [
        "candidate",
        "checked",
        "eligible"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "access_basis": {
      "default": "Not reviewed",
      "title": "Access Basis",
      "type": "string"
    },
    "snapshot_basis": {
      "default": "Not reviewed; no redistribution permission assumed",
      "title": "Snapshot Basis",
      "type": "string"
    },
    "robots_status": {
      "default": "unknown",
      "enum": [
        "unknown",
        "allowed",
        "denied"
      ],
      "title": "Robots Status",
      "type": "string"
    },
    "review_evidence": {
      "items": {
        "type": "string"
      },
      "title": "Review Evidence",
      "type": "array"
    },
    "observed_years": {
      "items": {
        "enum": [
          2024,
          2025,
          2026
        ],
        "type": "integer"
      },
      "title": "Observed Years",
      "type": "array"
    },
    "html_interval_seconds": {
      "default": 21600,
      "minimum": 3600,
      "title": "Html Interval Seconds",
      "type": "integer"
    },
    "attachment_interval_seconds": {
      "default": 86400,
      "minimum": 3600,
      "title": "Attachment Interval Seconds",
      "type": "integer"
    }
  },
  "required": [
    "profile_id",
    "university_key",
    "allowed_hosts",
    "seed_urls",
    "years",
    "authority_scope",
    "parser"
  ],
  "title": "SourceProfile",
  "type": "object"
}
