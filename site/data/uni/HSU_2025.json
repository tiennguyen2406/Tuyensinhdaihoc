 Đại học Quốc gia Hà Nội năm 2025.","Điểm thi ĐGNL đạt từ 600 điểm trở lên (thang điểm 1.200) đối với kỳ thi do ĐHQG TP.HCM tổ chức, và từ 67 điểm trở lên (thang điểm 150) đối với kỳ thi do ĐHQG Hà Nội tổ chức."],"formula":[],"bonus":[],"quota":[],"notes":[]},"timeline":[],"documents":[],"post_id":28734,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-hoa-sen","modified":"2025-12-22T08:36:58","school_name":"Trường Đại Học Hoa Sen","province":"Thành phố Hồ Chí Minh","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["HSA","TN THPT","VACT"]}}