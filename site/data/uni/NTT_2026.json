"25.540.000","unit":"đ/HK1"},{"name":"Tâm lý học","amount":"209.440.000","unit":"đ/toàn khóa"},{"name":"Luật kinh tế","amount":"27.190.000","unit":"đ/HK1"},{"name":"Luật kinh tế","amount":"217.120.000","unit":"đ/toàn khóa"},{"name":"CNTT","amount":"28.360.000","unit":"đ/HK1"},{"name":"CNTT","amount":"225.430.000","unit":"đ/toàn khóa"},{"name":"Kỹ thuật phần mềm","amount":"27.870.000","unit":"đ/HK1"},{"name":"Kỹ thuật phần mềm","amount":"224.210.000","unit":"đ/toàn khóa"}],"flags":["theo_hoc_ky","toan_khoa"],"only_major":null,"evidence":"official","note":"Chỉ là các ngành ví dụ trong phụ lục chính thức, không phải khoảng toàn trường.","sources":["https://kl.ntt.edu.vn/tin-tuc/ban-hanh-muc-thu-phi-hoc-phi-cac-nganh-dao-tao-trinh-do-dai-hoc-nam-2025/"],"auto_ok":false,"manual_override":true},"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-nguyen-tat-thanh-NTT.html","dean":{"year":2026,"methods_year":2026,"quota":[],"methods":[{"name":"Điểm thi THPT","fields":{"audience":[],"conditions":["Y khoa – Răng Hàm Mặt: 20,5.","Y học cổ truyền – Dược học: 19.","Y học dự phòng – Điều dưỡng – Kỹ thuật xét nghiệm y học – Kỹ thuật phục hồi chức năng – Luật – Luật kinh tế: 17.","Các ngành còn lại: 15 điểm.","Chương trình đào tạo các ngành Kiến trúc, Thiết kế nội thất, Thiết kế đồ họa của Trường Đại học Nguyễn Tất Thành với định hướng thực hành, sự thụ cảm cái đẹp, hiểu biết về lịch sử, tư duy logic là chìa khóa quan trọng thúc đẩy cảm xúc…"],"formula":["Đối với các ngành xét tuyển có tổ hợp môn năng khiếu, Nhà trường xét kết hợp điểm các môn cơ bản với điểm thi các môn năng khiếu do Trường ĐH Nguyễn Tất Thành tổ chức hoặc từ các Trường Đại học khác."],"bonus":[],"quota":[],"notes":["> Thông tin các đợt thi năng khiếu : .","Hình thức thi: Thi tập trung hoặc Nộp bài dự thi kết hợp phỏng vấn trực tuyến .","Thời gian dự kiến: > Đợt 1: từ ngày ra thông báo – 04/2026 > Đợt 2: 05/2026–06/2026 > Đợt 3: 07/2026 .","Hình thức đăng ký: trực tuyến theo thông báo tại Website: tuyensinh.ntt.edu.vn .","Lệ phí: 100.000đ/môn thi.","Trước mỗi đợt thi tập trung, trường tổ chức ôn thi miễn phí cho các thí sinh."]},"shared":true},{"name":"Điểm học bạ","fields":{"audience":[],"conditions":["Xét tuyển kết quả học bạ đạt 1 trong các tiêu chí: a.","Xét điểm Cả năm lớp 12: tổng ĐTB môn học cả năm lớp 12 theo tổ hợp môn đạt từ 18 trở lên.","Xét kết hợp: tổng ĐTB môn học cả năm lớp 12 theo tổ hợp môn kết hợp Điểm thi tốt nghiệp THPT/ Điểm thi Đánh giá năng lực (ĐGNL) đạt từ 18 trở lên.","Điểm xét Tốt nghiệp (trên Giấy chứng nhận Tốt nghiệp) / ĐTB Cả năm lớp 12 (tất cả các môn) từ 6,0 trở lên.","Ngưỡng đảm bảo chất lượng đầu vào.","Các ngành còn lại xét từ 6 điểm đối với điểm trung bình học bạ lớp 12."],"formula":["Trong thời hạn quy định của mỗi đợt, thí sinh đăng ký xét tuyển online tại website: tuyensinh.ntt.edu.vn => Đăng ký xét tuyển => Đăng ký xét tuyển Đại Học Chính Quy hoặc qua bưu điện bằng chuyển phát nhanh/chuyển phát ưu tiên hoặc có thể…"],"bonus":[],"quota":[],"notes":["Phiếu đăng ký xét tuyển (nếu đăng ký trực tiếp)","Học bạ THPT (bản sao)","Bằng tốt nghiệp THPT hoặc Giấy Chứng nhận TN tạm thời (bản sao)"]},"shared":true},{"name":"Điểm ĐGNL HN","fields":{"audience":[],"conditions":["Điểm bài thi kiểm tra đánh giá năng lực của ĐHQG-HN đạt từ 70 điểm trở lên và đạt mức điểm chuẩn đầu vào theo từng ngành do trường ĐH Nguyễn Tất Thành xác định sau khi có kết quả."],"formula":[],"bonus":[],"quota":[],"notes":["Bản chính phiếu kết quả thi đánh giá năng lực năm 2026 của ĐHQG-HN."]},"shared":true},{"name":"Điểm ĐGNL HCM","fields":{"audience":[],"conditions":["Điểm bài thi kiểm tra đánh giá năng lực của ĐHQG-HCM đạt từ 550 điểm và đạt mức điểm chuẩn đầu vào theo từng ngành do trường ĐH Nguyễn Tất Thành xác định sau khi có kết quả."],"formula":[],"bonus":[],"quota":[],"notes":["Bản chính phiếu kết quả thi đánh giá năng lực năm 2026 của ĐHQG-HCM."]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":[],"conditions":["Xét tuyển các thí sinh người nước ngoài đủ điều kiện học tập hoặc theo diện cử tuyển.","Ngành Ngôn ngữ Anh: có chứng chỉ IELTS từ 6.0/9,0 hoặc TOEIC (L&R) 700/990 hoặc TOEIC (Bridge) 85/100 hoặc TOEFL iBT từ 70/120 hoặc TOEFL ITP từ 500/677 hoặc Cambridge từ 165/230.","Thí sinh có chứng chỉ IELTS từ 4.5/9,0 hoặc TOEIC (L&R) 550/990 hoặc TOEIC (Bridge) 76/100 hoặc TOEFL iBT từ 30/120 hoặc TOEFL ITP từ 450/677 hoặc Cambridge từ 140/230 được ưu tiên xét tuyển vào các ngành có môn Tiếng Anh với mức điểm thay…"],"formula":["Thí sinh có kết quả kỳ thi SAT hoặc ACT đạt từ 60% trở lên (950/1600 với SAT hoặc 25/36 với ACT) được ưu tiên xét tuyển vào các ngành có môn Toán, Tiếng Anh với mức điểm thay thế tương đương điểm 8 theo thang điểm 10."],"bonus":["Tổng điểm 3 môn thi tốt nghiệp THPT năm 2026 ứng với tổ hợp xét tuyển của ngành đăng ký đạt 21 điểm trở lên đã cộng điểm ưu tiên.","Tổng điểm trung bình cuối năm của 3 môn học bạ lớp 12 ứng với tổ hợp xét tuyển của ngành đăng ký đạt 21 điểm trở lên đã cộng điểm ưu tiên.","Bảng 2: Mức điểm cộng/quy đổi với thí sinh học THPT tại nước ngoài và có chứng chỉ tiếng Anh theo Khung Năng lực Ngoại ngữ Việt Nam."],"quota":[],"notes":["Phương thức: Xét tuyển thẳng, ưu tiên xét tuyển các thí sinh đạt giải kỳ thi học sinh giỏi quốc gia, cuộc thi Khoa học kỹ thuật quốc gia, Kỳ thi tay nghề Asean và quốc tế.","Theo quy định tuyển sinh của BGDĐT.","Đã tốt nghiệp đại học.","Các ngành thuộc khối khoa học sức khỏe cần áp dụng theo mục 2."]},"shared":false}],"common":{"audience":[],"conditions":["Các ngành thuộc lĩnh vực sức khỏe và đào tạo giáo viên xét theo quy định về ngưỡng đảm bảo chất lượng đầu vào của Bộ GD&ĐT.","Ngành Y khoa, Răng-Hàm-Mặt, Y học cổ truyền, Dược học: học lực lớp 12 xếp loại Tốt.","Điểm xét tốt nghiệp THPT từ 8,0 trở lên.","Ngành Y học dự phòng, Xét nghiệm y học , Điều dưỡng, Kỹ thuật PHCN: học lực lớp 12 xếp loại từ Khá.","Điểm xét tốt nghiệp THPT từ 6,5 trở lên."],"formula":["Các ngành thuộc lĩnh vực sức khỏe và các ngành xét tuyển có tổ hợp môn năng khiếu.","Hình thức nhận hồ sơ ĐKXT: Trong thời hạn quy định của mỗi đợt, thí sinh đăng ký xét tuyển online tại website: tuyensinh.ntt.edu.vn => Đăng ký xét tuyển => Đăng ký xét tuyển Đại Học Chính Quy hoặc qua bưu điện bằng chuyển phát nhanh/chuyển…"],"bonus":[],"quota":[],"notes":["Lệ phí xét tuyển 30,000đ/hồ sơ.","Giấy chứng nhận ưu tiên (nếu có).","Phiếu đăng ký xét tuyển.","Bằng tốt nghiệp THPT hoặc Giấy CNTN tạm thời (bản sao)"]},"timeline":[{"date":"02-07-2026 – 14-07-2026","event":"Xét tuyển"},{"date":"01/02/2026","event":"Xét tuyển: thông báo"},{"date":"01/04/2026 – 09/04/2026","event":"Xét tuyển"}],"documents":["Học bạ THPT"],"post_id":28626,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-nguyen-tat-thanh","modified":"2025-12-19T08:21:42","school_name":"Trường Đại Học Nguyễn Tất Thành","province":"Thành phố Hồ Chí Minh","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["HSA","TN THPT","VACT"]}}