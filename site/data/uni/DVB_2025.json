ram_name":"Công nghệ thông tin","major_code":"7480201","program_type":"CHUAN","combos":"A00;A01;D01;X06","scores":{"THPT":{"score":15.0,"scale":30.0,"equiv":null},"HOCBA":{"score":15.0,"scale":30.0,"equiv":null}},"notes":[]}],"tuition":null,"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-kinh-te-cong-nghe-thai-nguyen-DVB.html","dean":{"year":2026,"methods_year":2025,"quota":[],"methods":[{"name":"Điểm thi THPT","fields":{"audience":["Là học sinh đã tốt nghiệp THPT theo hình thức giáo dục chính quy hoặc giáo dục thường xuyền.","Đáp ứng các quy định về sức khỏe và các điều kiện dự tuyển khác theo Quy chế tuyển sinh đại học hiện hành của Bộ Giáo dục và Đào tạo.."],"conditions":[],"formula":["Điểm xét tuyển: Điểm thi TN THPT 2025 = Điểm môn 1 + Điểm môn 2 + Điểm môn 3 Điểm xét tuyển theo điểm thi TN THPT năm 2025 = Điểm thi TN THPT 2025 + điểm UT (nếu có)"],"bonus":[],"quota":[],"notes":["Dựa vào điểm thi của thí sinh trong kỳ thi tốt nghiệp (TN) THPT năm 2025, Nhà trường sẽ xác định và công bố điểm xét tuyển theo quy định của Bộ GD&ĐT."]},"shared":true},{"name":"Điểm học bạ","fields":{"audience":["Tuyển sinh trong cả nước.","Ưu tiên tuyển sinh các tỉnh trung du và miền núi phía Bắc.","Thí sinh có bằng tốt nghiệp THPT hoặc có Giấy chứng nhận tốt nghiệp tạm thời.","Thí sinh đã tốt nghiệp THPT theo hình thức giáo dục chính quy hoặc giáo dục thường xuyên."],"conditions":[],"formula":["Điểm học bạ = Điểm TB cả năm lớp 10 + Điểm TB cả năm lớp 11 + Điểm TB cả năm lớp 12 + điểm ƯT (nếu có) ≥15.","Điểm học bạ = Điểm TB cả năm lớp 12 môn 1 + Điểm TB cả năm lớp 12 môn 2 + Điểm TB cả năm lớp 12 môn 3 + điểm ƯT (nếu có) ≥ 15."],"bonus":["Một là: Tổng điểm trung bình chung học tập lớp 10 + lớp 11 + lớp 12 + điểm ưu tiên đạt từ 15 điểm trở lên.","Hai là: Tổng điểm trung bình học tập của 3 môn theo tổ hợp xét tuyển lớp 12 + điểm ưu tiên đạt từ 15 điểm trở lên."],"quota":[],"notes":["Nhà trường xét căn cứ vào kết quả học tập ghi trong học bạ THPТ."]},"shared":true}],"common":{"audience":[],"conditions":[],"formula":["Các môn 1, môn 2, môn 3 được xác định theo các tổ hợp xét tuyển.","Điểm trúng tuyển giữa các tổ hợp là tương đương nhau (không có chênh lệch điểm trúng tuyển giữa các tổ hợp)."],"bonus":["Điểm ƯT là điểm ưu tiên khu vực, đối tượng (nếu có) và được tính theo quy chế tuyển sinh hiện hành."],"quota":[],"notes":["Điểm xét tuyển không vượt quá 30 điểm."]},"timeline":[],"documents":[],"post_id":28800,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-kinh-te-cong-nghe-thai-nguyen","modified":"2025-12-22T08:44:56","school_name":"Trường Đại Học Kinh tế công nghệ Thái Nguyên","province":"Khác","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["TN THPT"]}}