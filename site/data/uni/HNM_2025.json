,"notes":[]},"shared":false},{"name":"Chứng chỉ quốc tế kết hợp với điểm thi THPT","fields":{"audience":[],"conditions":["Xét tuyển dựa vào chứng chỉ năng lực ngoại ngữ quốc tế bậc 3 hoặc tương đương trở lên (trong thời hạn 2 năm tính đến thời điểm nộp hồ sơ) kết hợp điểm môn thi tốt nghiệp THPT."],"formula":["Điểm xét tuyển = (Ax 2)+ (B+C)/2+D.","A là điểm quy đổi chứng chỉ năng lực ngoại ngữ quốc tế.","Điểm quy đổi chứng chỉ năng lực ngoại ngữ quốc tế quy định như sau: Nhà trường công nhận những loại chứng chỉ sau: Tiếng Anh (IELTS, TOEFL IBT, TOEFL ITP)"],"bonus":["D là điểm ưu tiên (nếu có)"],"quota":[],"notes":["Không áp dụng với ngành Giáo dục thể chất.","B là điểm thi tốt nghiệp THPT năm 2025 môn Toán.","C là điểm thi tốt nghiệp THPT năm 2025 môn Ngữ văn.","Tiếng Trung Quốc (chứng chỉ HSK)."]},"shared":false},{"name":"Điểm ĐGNL ĐH Sư phạm HN","fields":{"audience":[],"conditions":[],"formula":["Điểm thành phần trong tổ hợp xét tuyển là điểm thi của thí sinh trong kỳ thi đánh giá năng lực năm 2025 của Trường ĐH Sư phạm Hà Nội tổ chức tương ứng theo từng tổ hợp xét tuyển."],"bonus":[],"quota":[],"notes":[]},"shared":true}],"common":{"audience":[],"conditions":[],"formula":["Điểm xét tuyển = (Môn 1) + (Môn 2) + (Môn 3) + [Điểm UT (nếu có)].","Điểm ưu tiên đối với thí sinh đạt tổng điểm từ 22,5 trở lên (khi quy đổi về điểm theo thang 10 và tổng điểm 3 môn tối đa là 30) được xác định theo công thức sau.","Điểm ưu tiên = [(30 – Tổng điểm đạt được)/7,5] × Mức điểm ưu tiên."],"bonus":[],"quota":[],"notes":[]},"timeline":[{"date":"03/6/2025 – 10/6/2025","event":"Thu hồ sơ"}],"documents":["Lệ phí: 50.000đ/phương thức","Lệ phí thi năng khiếu: 400.000đ/thí sinh"],"post_id":28366,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-thu-do-ha-noi","modified":"2025-12-22T07:48:49","school_name":"Trường Đại học Thủ Đô Hà Nội","province":"Thành phố Hà Nội","groups":["Kỹ thuật"],"taxonomy_years":["2025"],"method_tags":["TN THPT"]}}