i-hoc-dien-luc-DDL.html","dean":{"year":2025,"methods_year":2025,"quota":["Trường Đại học Điện tuyển 6.800 chỉ tiêu cho 32 ngành học, tăng 13 ngành học và tăng khoảng 2.800 chỉ tiêu."],"methods":[{"name":"Điểm thi THPT","fields":{"audience":[],"conditions":["Thí sinh đạt ngưỡng đảm bảo chất lượng đầu vào theo ngành xét tuyển của Trường năm 2025."],"formula":["Đối với các thí sinh sử dụng tổ hợp xét tuyển có môn tiếng Anh có thể sử dụng chứng chỉ tiếng Anh Qụổc tế IELTS hoặc TOFEL IBT (còn hiệu lực đến ngày 20/7/2025) thay thế cho điểm thi tốt nghiệp môn tiếng Anh và được quy đối theo Bảng điểm…"],"bonus":["Sử dụng kết quả điểm trong kỳ thi tốt nghiệp THPT năm 2025 của 3 môn theo tố hợp xét tuyển và điểm ưu tiên (nếu có)"],"quota":[],"notes":["Cách thức nộp hồ sơ đăng ký xét tuyến: Thí sinh đăng ký nguyện vọng trên hệ thống đăng ký xét tuyển của Bộ Giáo dục và Đào tạo (theo quy chế tuyển sinh hiện hành)"]},"shared":false},{"name":"Điểm học bạ","fields":{"audience":[],"conditions":[],"formula":["Thí sinh có tổng điểm xét tuyển 3 môn trong tổ hợp xét tuyển không thấp hơn 18 điểm theo thang điểm 30."],"bonus":["Sử dụng kết quả học tập cả năm lớp 10, 11, 12 của 3 môn theo tổ hợp xét tuyển và điểm ưu tiên (nếu có)"],"quota":[],"notes":["Cách thức xét tuyến."]},"shared":false},{"name":"Xét tuyển kết hợp CCTAQT và học bạ","fields":{"audience":[],"conditions":["Điểm chứng chỉ tiếng Anh quốc tế đạt EELTS >5,0 hoặc TOEFL IBT >35.","Thí sinh thỏa mãn cùng lúc 2 điều kiện sau đây."],"formula":["Xét tuyển kết hợp dựa trên chứng chỉ tiếng Anh quốc tế kết hợp với kết quả học tập (học bạ) 2 môn còn lại trong tổ hợp xét tuyển.","Sử dụng kết quả học tập cả năm lớp 10, 11, 12 của 2 môn còn lại theo tổ hợp xét tuyển.","Bảng điểm quy đổi các chứng chỉ tiếng Anh Quốc tế được Bộ Giáo dục và Đào tạo công nhận."],"bonus":["Thí sinh có tổng điểm xét tuyển: điểm Chứng chỉ TAQT quy đổi và 2 môn còn lại trong tổ hợp xét tuyển không thấp hơn 18 điểm theo thang điểm 30 và điểm ưu tiên (nếu có)"],"quota":[],"notes":["Cách thức xét tuyển.","Có chứng chỉ tiếng Anh quốc tế IELTS hoặc TOEFL IBT trong thời hạn 2 năm tính đến ngày 20/7/2025.","Cách thức nộp hồ sơ đăng ký xét tuyển.","Dự kiến tháng 4/2025 thí sinh sẽ đăng ký trực tuyến trên cổng TTTS: www.tuyensinh.epu.edu.vn hoặc nộp hồ sơ trực tiếp tại bộ phận tuyển sinh, Trường Đại học Điện lực.","(Mọi thông tin chỉ tiết về việc nộp hồ sơ sẽ được Nhà trường thông báo trên công TTTS)"]},"shared":false},{"name":"ƯTXT, XT thẳng","fields":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Xét tuyển thẳng theo quy định trong quy chế tuyển sinh hiện hành của Bộ GD&ĐT.","(Không giới hạn chỉ tiêu)"]},"shared":false}],"common":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"timeline":[{"date":"tháng 4","event":"Thí sinh sẽ đăng ký xét tuyển trực tuyến hoặc trực tiếp"},{"date":"15/7/2025","event":"Đăng ký"}],"documents":["Căn cước công dân","Giấy chứng nhận tốt nghiệp hoặc Bằng tốt nghiệp THPT đối với các thí sinh tự do","Chứng chỉ TA Quốc tế đối với các thí sinh xét tuyển kết hợp"],"post_id":28606,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-dien-luc","modified":"2025-12-19T08:15:38","school_name":"Trường Đại Học Điện Lực","province":"Thành phố Hà Nội","groups":["Kỹ thuật"],"taxonomy_years":["2025"],"method_tags":["TN THPT"]}}