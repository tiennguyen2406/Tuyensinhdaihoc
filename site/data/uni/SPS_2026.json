":25.8,"scale":30.0,"equiv":null},{"score":25.42,"scale":30.0,"equiv":null},{"score":25.17,"scale":30.0,"equiv":null}]},"notes":[]}],"tuition":{"uni_code":"SPS","year":2026,"min_mil":19.1,"max_mil":25.08,"unit_note":null,"text":"Ngành ngoài sư phạm; ngành sư phạm được Nhà nước hỗ trợ tiền đóng học phí","source_url":"https://dienthoaivui.com.vn/tin-tuc/top-truong-dai-hoc-lay-diem-cao-nhat-tp-hcm","source_type":"aggregator","confidence":"low"},"tuition_extra":null,"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-su-pham-tphcm-SPS.html","dean":{"year":2026,"methods_year":2025,"quota":["Trường Đại học Sư phạm Thành phố Hồ Chí Minh tuyển 5.715 chỉ tiêu và theo 4 phương thức.","Các thông tin về phương thức xét tuyển và chỉ tiêu xét tuyển trên là dự kiến, Trường sẽ cập nhật khi có các văn bảng hướng dẫn tuyển sinh năm 2026 của Bộ Giáo dục và Đào tạo."],"methods":[{"name":"Điểm thi THPT","fields":{"audience":[],"conditions":["Xét tuyển sử dụng kết quả thi tốt nghiệp THPT năm 2025: ngưỡng điểm đảm bảo chất lượng đầu vào, điều kiện nhận hồ sơ đăng ký xét tuyển được thông báo chính thức sau khi Bộ Giáo dục và Đào tạo xác định ngưỡng đảm bảo chất lượng đầu vào đại…"],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Phương thức tuyển sinh này (áp dụng cho tất cả các ngành trừ ngành Giáo dục Thể chất, Giáo dục Mầm non và Giáo dục Quốc phòng – An ninh).","fields":{"audience":["Mô tả phương án.","Với mỗi ngành học, Trường sử dụng tổ hợp 3 môn thi của kỳ thi tốt nghiệp THPT năm 2025 để xét tuyển.","Trong đó, bắt buộc có môn Toán hoặc môn Ngữ văn.","Hình thức xét tuyển.","Đ XT : điểm xét tuyển, được làm tròn đến hai chữ số thập phân.","Đ M1 , Đ M2, Đ M3 : điểm môn thi thứ nhất, thứ hai, thứ ba theo tổ hợp xét tuyển.","Xét tuyển từ cao xuống thấp cho đến khi đủ chỉ tiêu.","Quy đổi chứng chỉ ngoại ngữ trong xét tuyển đại học, cao đẳng ngành Giáo dục Mầm non: đối với phương thức xét tuyển sử dụng kết quả thi tốt nghiệp THPT…","Tiêu chí phân ngành, chương trình đào tạo.","Chương trình Sư phạm Toán học dạy bằng song ngữ Việt – Anh.","Thí sinh đã trúng tuyển ngành Sư phạm Toán học có nguyện vọng học chương trình song ngữ.","Tổ chức xét tuyển dựa vào chứng chỉ tiếng Anh hoặc bài đánh giá độc lập về năng lực tiếng Anh."],"conditions":[],"formula":["Đ XT = Đ M1 + Đ M2 + Đ M3 + Đ UT."],"bonus":["Điểm xét tuyển là tổng điểm các bài thi/môn thi của từng tổ hợp xét tuyển (từng môn thi chấm theo thang điểm 10) cộng với điểm ưu tiên đối tượng, khu vực theo quy định của Bộ Giáo dục và Đào tạo và được làm tròn đến hai chữ số thập phân."],"quota":[],"notes":[]},"shared":true},{"name":"Phương thức tuyển sinh này chỉ áp dụng cho ngành Giáo dục Thể chất, Giáo dục Mầm non và Giáo dục Quốc phòng – An ninh .","fields":{"audience":["Mô tả phương án.","Với mỗi ngành học, Trường sử dụng kết quả bài thi Ngữ văn hoặc Toán của kỳ thi tốt nghiệp THPT năm 2025 và 2 môn thi năng khiếu do Trường Đại học Sư phạm Thành phố Hồ Chí Minh tổ chức để xét tuyển.","Hình thức xét tuyển.","Đ XT : điểm xét tuyển, được làm tròn đến hai chữ số thập phân.","Đ M : điểm bài thi Ngữ văn hoặc Toán.","Đ NK1, Đ NK2 : điểm môn thi năng khiếu do Trường Đại học Sư phạm Thành phố Hồ Chí Minh tổ chức.","Xét tuyển từ cao xuống thấp cho đến khi đủ chỉ tiêu.","Tiêu chí phân ngành, chương trình đào tạo.","Chương trình Sư phạm Toán học dạy bằng song ngữ Việt – Anh.","Thí sinh đã trúng tuyển ngành Sư phạm Toán học có nguyện vọng học chương trình song ngữ.","Tổ chức xét tuyển dựa vào chứng chỉ tiếng Anh hoặc bài đánh giá độc lập về năng lực tiếng Anh.","Xét tuyển từ cao xuống thấp cho đến khi hết chỉ tiêu."],"conditions":[],"formula":[],"bonus":["Điểm xét tuyển là tổng điểm bài thi Ngữ văn hoặc Toán của kỳ thi tốt nghiệp THPT năm 2025 (theo tổ hợp môn đăng ký xét tuyển) với điểm thi 2 môn thi năng khiếu do Trường tổ chức cộng điểm ưu tiên đối tượng…"],"quota":[],"notes":[]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Trường thực hiện xét tuyển thẳng cho thí sinh thỏa các quy định tại Khoản 1, 2, 3 Điều 7 Quy chế tuyển sinh đại học.","Tuyển sinh cao đẳng ngành Giáo dục Mầm non tại Trường Đại học Sư phạm Thành phố Hồ Chí Minh.","Trích khoản 1, 2, 3, 5 điều 7 Quy chế tuyển sinh đại học , tuyển sinh cao đẳng ngành Giáo dục Mầm non tại Trường Đại học Sư phạm Thành phố Hồ Chí Minh được ban hành kèm theo Quyết định số 949 /QĐ-ĐHSP ngày 8/ 4 /202 5 của Hiệu trưởng…","Đối tượng xét tuyển thẳng và ưu tiên xét tuyển.","Anh hùng lao động, Anh hùng lực lượng vũ trang nhân dân, Chiến sĩ thi đua toàn quốc được tuyển thẳng vào các ngành, chương trình do cơ sở đào tạo quy định.","Thí sinh đạt thành tích cao trong các kỳ thi, cuộc thi, giải đấu cấp quốc gia hoặc quốc tế, do Bộ GDĐT, Bộ Văn hóa, Thể thao và Du lịch tổ chức, cử tham gia, được xét tuyển thẳng vào các ngành phù hợp với môn thi…","Thí sinh đoạt giải nhất, nhì, ba trong kỳ thi chọn học sinh giỏi quốc gia, quốc tế hoặc thi khoa học, kỹ thuật cấp quốc gia, quốc tế do Bộ GDĐT tổ chức, cử tham gia.","Thời gian đoạt giải không quá 3 năm tính tới thời điểm xét tuyển thẳng.","Thí sinh đoạt giải chính thức trong các cuộc thi nghệ thuật quốc tế về ca, múa, nhạc, mỹ thuật được Bộ Văn hóa, Thể thao và Du lịch công nhận.","Thời gian đoạt giải không quá 4 năm tính tới thời điểm xét tuyển thẳng.","Thí sinh tham gia đội tuyển quốc gia thi đấu tại các giải quốc tế chính thức được Bộ Văn hoá, Thể thao và Du lịch xác nhận đã hoàn thành nhiệm vụ, bao gồm: Giải vô địch thế giới, Cúp thế giới, Thế vận hội Olympic…","Thí sinh đoạt giải nhất, nhì, ba trong các kỳ thi tay nghề khu vực ASEAN và thi tay nghề quốc tế do Bộ Lao động – Thương binh và Xã hội cử đi."],"conditions":["Thí sinh có nơi thường trú từ 3 năm trở lên, học 3 năm và tốt nghiệp THPT tại các huyện nghèo (học sinh học phổ thông dân tộc nội trú tính theo nơi thường trú) theo quy định của Chính phủ, Thủ tướng Chính phủ.","Thí sinh có bằng trung cấp ngành sư phạm loại giỏi trở lên, hoặc có bằng trung cấp ngành sư phạm loại khá và có ít nhất 2 năm làm việc đúng ngành được xét tuyển thẳng vào ngành Giáo dục Mầm non trình độ cao đẳng.","Riêng đối với ngành Giáo dục Mầm non, Giáo dục Quốc phòng – An ninh thí sinh phải tham gia kỳ thi năng khiếu do Trường tổ chức và đạt từ 6,5 điểm trở lên đối với mỗi môn .","Trường xét tuyển những thí sinh thoả các điều kiện theo Khoản 4, Điều 7, Quy chế tuyển sinh đại học, tuyển sinh cao đẳng ngành Giáo dục Mầm non tại Trường Đại học Sư phạm Thành phố Hồ Chí Minh được ban hành kèm theo Quyết định số…","Riêng đối với ngành Giáo dục Mầm non, Giáo dục Quốc phòng – An ninh thí sinh phải tham gia kỳ thi năng khiếu do Trường tổ chức và đạt từ 6,5 điểm trở lên.","Đối với mỗi ngành học, Trường xét tuyển những thí sinh đã tốt nghiệp các trường THPT (theo DS trường công bố) có xếp loại học lực lớp 12 chuyên năm học 2024 – 2025 từ tốt trở lên và đạt một trong các điều kiện theo thứ tự ưu tiên sau vào…","Đạt giải nhất, nhì, ba kỳ thi học sinh giỏi do cấp tỉnh trở lên tổ chức.","Thí sinh có chứng chỉ ngoại ngữ bậc 4 theo khung năng lực ngoại ngữ 6 bậc dùng cho Việt Nam trở lên hoặc tương đương theo phụ lục 3 (áp dụng đối với các ngành ngoại ngữ theo danh mục ngành đúng ngành gần)","Có học lực năm học lớp 10 và 11 chuyên đạt loại tốt.","Riêng đối với ngành Giáo dục Mầm non, Giáo dục Thể chất, Giáo dục Quốc phòng – An ninh thí sinh phải tham gia kỳ thi năng khiếu do Trường tổ chức và đạt từ 6,5 điểm trở lên."],"formula":[],"bonus":[],"quota":[],"notes":["Ưu tiên xét tuyển theo Quy chế tuyển sinh và xét tuyển thí sinh là học sinh lớp chuyên.","Phương thức này áp dụng với tất cả các ngành.","Đối với Ưu tiên xét tuyển theo Quy chế tuyển sinh.","Đối với Xét tuyển thí sinh là học sinh lớp chuyên.","Tham gia đội tuyển học sinh giỏi quốc gia hoặc đội tuyển cuộc thi khoa học kĩ thuật cấp quốc gia.","Hình thức xét tuyển: xét tuyển từ cao xuống thấp theo thứ tự ưu tiên của các tiêu chí cho đến khi hết chỉ tiêu.","Hồ sơ xét tuyển: Đối với phương thức xét tuyển thẳng, ưu tiên xét tuyển.","Phiếu đăng ký xét tuyển (khai báo trực tuyến)","Phiếu đăng ký xét tuyển thẳng (theo mẫu Phụ lục 4 hoặc Phụ lục 5 của Bộ Giáo dục và Đào tạo), các minh chứng theo yêu cầu của xét tuyển (khai báo trực tuyến).","Đối với các phương thức còn lại: theo quy định của Bộ Giáo dục và Đào tạo (thí sinh cần cung cấp bổ sung minh chứng xét tuyển phù hợp với yêu cầu của phương thức xét tuyển)"]},"shared":true},{"name":"Học bạ kết hợp với điểm thi ĐGNL chuyên biệt","fields":{"audience":[],"conditions":["Đối với phương thức xét tuyển sử dụng kết quả học tập THPT kết hợp thi đánh giá năng lực chuyên biệt.","Phương thức xét tuyển này chỉ áp dụng đối với thí sinh tốt nghiệp THPT năm 2025, tham gia kỳ thi đánh giá năng lực chuyên biệt do Trường Đại học Sư phạm Thành phố Hồ Chí Minh hoặc Trường Đại học Sư phạm Hà Nội…","Phải tham gia kỳ thi năng khiếu do Trường Đại học Sư phạm Thành phố Hồ Chí Minh tổ chức và có kết quả đạt từ 5,0 điểm trở lên đối với mỗi môn thi.","Đối với thí sinh xét tuyển sử dụng kết quả thi tốt nghiệp THPT năm 2025: ngưỡng điểm đảm bảo chất lượng đầu vào được thông báo chính thức sau khi Bộ Giáo dục và Đào tạo xác định ngưỡng đảm bảo chất lượng đầu vào đại học…"],"formula":["Hai môn còn lại trong tổ hợp xét tuyển được lấy kết quả học tập ở THPT.","Đ XT = (0.5xĐ MC + 0.25xĐ M1 + 0.25xĐ M2)x3 + Đ UT.","Đ M1 , Đ M2 : điểm trung bình 6 học kỳ ở THPT của hai môn còn lại theo tổ hợp xét tuyển."],"bonus":["Tổng điểm này được quy đổi về thang điểm 30 và cộng điểm ưu tiên đối tượng, khu vực theo quy định của Bộ Giáo dục và Đào tạo và được làm tròn đến hai chữ số thập phân."],"quota":[],"notes":["Phương thức tuyển sinh này chỉ áp dụng cho các ngành: Sư phạm Toán học, Sư phạm Tin học, Công nghệ thông tin, Sư phạm Vật lý, Vật lý học, Sư phạm Hóa học, Hoá học, Sư phạm Sinh học, Sư phạm Ngữ văn, Văn học, Việt Nam học, Sư phạm Tiếng Anh…","Môn chính ứng với ngành học được lấy kết quả từ kỳ thi đánh giá năng lực chuyên biệt do Trường Đại học Sư phạm Thành phố Hồ Chí Minh, Trường Đại học Sư phạm Hà Nội hoặc Trường Đại học Sư phạm Hà Nội 2 tổ chức.","Điểm xét tuyển được xác định: tổng điểm bài thi đánh giá năng lực chuyên biệt do Trường tổ chức trong năm 2024, 2025 hoặc Trường Đại học Sư phạm Hà Nội…","Đ MC : điểm môn chính được lấy từ kết quả thi đánh giá năng lực chuyên biệt do Trường Đại học Sư phạm Thành phố Hồ Chí Minh tổ chức năm 2024, 2025 hoặc Trường Đại học Sư phạm Hà Nội…"]},"shared":true},{"name":"Kết hợp điểm thi ĐGNL riêng biệt với điểm năng khiếu","fields":{"audience":[],"conditions":["Đối với thí sinh xét tuyển sử dụng kết quả đánh giá năng lực chuyên biệt kết hợp với thi năng khiếu: chỉ áp dụng đối với thí sinh tốt nghiệp THPT năm 2025 đồng thời thỏa thêm một trong các điều kiện sau.","Có học lực lớp 12 đạt loại khá trở lên.","Là vận động viên cấp 1, kiện tướng, vận động viên đã từng đoạt huy chương tại Hội khỏe Phù Đổng, các giải trẻ quốc gia và quốc tế hoặc giải vô địch quốc gia và quốc tế có điểm thi năng khiếu do trường tổ chức đạt loại xuất sắc…","Thí sinh dự xét tuyển ngành Giáo dục Quốc phòng – An ninh."],"formula":["Với mỗi ngành học, Trường sử dụng kết quả thi đánh giá năng lực chuyên biệt môn Toán hoặc Văn (tùy theo tổ hợp xét tuyển) và 2 môn thi năng khiếu do Trường Đại học Sư phạm Thành phố Hồ Chí Minh tổ chức để xét tuyển."],"bonus":["Điểm xét tuyển là tổng điểm bài thi đánh giá năng lực chuyên biệt của môn Ngữ văn hoặc Toán (theo tổ hợp môn đăng ký xét tuyển) với điểm thi 2 môn thi năng khiếu do Trường tổ chức cộng điểm ưu tiên đối tượng…"],"quota":[],"notes":["Phương thức tuyển sinh này chỉ áp dụng cho các ngành Giáo dục Thể chất, Giáo dục Mầm non và Giáo dục Quốc phòng – An ninh .","Đ M : điểm bài thi đánh giá năng lực chuyên biệt môn Toán hoặc Văn do Trường Đại học Sư phạm Thành phố Hồ Chí Minh tổ chức năm 2024, 2025 hoặc Trường Đại học Sư phạm Hà Nội…","Đ NK1, Đ NK2 : điểm môn thi năng khiếu do Trường Đại học Sư phạm Thành phố Hồ Chí Minh tổ chức."]},"shared":true}],"common":{"audience":[],"conditions":["Có học lực lớp 12 đạt loại tốt.","Có điểm xét tốt nghiệp THPT từ 8,0 trở lên.","Thí sinh dự xét tuyển ngành Giáo dục Mầm non trình độ đại học.","Đối với thí sinh xét tuyển sử dụng kết quả đánh giá năng lực chuyên biệt kết hợp với thi năng khiếu: chỉ áp dụng đối với thí sinh tốt nghiệp THPT năm 2025 đồng thời phải thỏa một trong hai điều kiện sau.","Thí sinh dự xét tuyển ngành Giáo dục Mầm non trình độ cao đẳng.","Có học lực lớp 12 đạt loại khá.","Có điểm xét tốt nghiệp THPT từ 6,5 trở lên.","Thí sinh dự xét tuyển ngành Giáo dục Thể chất."],"formula":["Đ XT = Đ M + Đ NK1 + Đ NK2 + Đ UT."],"bonus":["Đ UT : điểm ưu tiên đối tượng, khu vực theo quy định của Bộ Giáo dục và Đào tạo."],"quota":[],"notes":["Mô tả phương án.","Hình thức xét tuyển.","Đ XT : điểm xét tuyển, được làm tròn đến hai chữ số thập phân.","Xét tuyển từ cao xuống thấp cho đến khi đủ chỉ tiêu."]},"timeline":[{"date":"01/7 – 20/7/2025","event":"Xét tuyển"},{"date":"01/6/2025 – 30/6/2025","event":"Đăng ký"}],"documents":[],"post_id":28360,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-su-pham-tphcm","modified":"2025-12-22T07:47:28","school_name":"Trường Đại Học Sư Phạm TPHCM","province":"Thành phố Hồ Chí Minh","groups":["Sư phạm"],"taxonomy_years":["2025"],"method_tags":["TN THPT"]}}