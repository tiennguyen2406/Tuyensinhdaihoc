U.html","dean":{"year":2025,"methods_year":2025,"quota":[],"methods":[{"name":"Điểm thi THPT","fields":{"audience":[],"conditions":[],"formula":["Xét theo tổ hợp 3 môn từ kết quả thi THPT năm 2025 và các năm trước 2025.","Ngưỡng đảm bảo chất lượng đầu vào tổng của 3 môn theo tổ hợp xét tuyển là 15,0 điểm.","Môn Ngoại ngữ được quy đổi tương đương về thang điểm 10 trong tổ hợp nếu các thí sinh dùng chứng chỉ ngoại ngữ để xét tuyển."],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Điểm học bạ","fields":{"audience":[],"conditions":[],"formula":["Ngưỡng đảm bảo chất lượng đầu vào là tổng điểm trung bình của 4 học kỳ bậc THPT (lớp 11, lớp 12) của 3 môn theo tổ hợp xét tuyển đạt từ 18,0 điểm trở lên."],"bonus":[],"quota":[],"notes":["Xét học bạ 4 kỳ gồm 2 học kỳ lớp 11 và 2 học kỳ lớp 12."]},"shared":false},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Xét tuyển thẳng theo quy chế tuyển sinh của Bộ Giáo dục và Đào tạo.","Học sinh đạt giải nhất, nhì, ba kỳ thi chọn học sinh giỏi cấp Quốc gia do Bộ Giáo dục và Đào tạo tổ chức.","Ưu tiên xét tuyển thẳng theo Đề án riêng.","Đối tượng 1: Học sinh tốt nghiệp năm 2025 có kết quả học tập “TỐT” (“KHÁ” – Trường chuyên) năm lớp 11, 12 và kết quả rèn luyện “KHÁ”.","Học sinh tốt nghiệp năm 2025 và đạt giải nhất, nhì, ba học sinh giỏi cấp tỉnh một trong các môn Toán, Ngữ văn, Lý, Hóa, Sinh, Tiếng anh, Lịch sử, Địa lý, GDKT và PL, Công nghệ, Tin học và đạt giải nhất, nhì…"],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Điểm Đánh giá đầu vào V-SAT","fields":{"audience":[],"conditions":[],"formula":["Xét tuyển sử dụng kết quả thi đánh giá năng lực do Đại học quốc gia tổ chức, V-SAT từ 225 điểm tổng tổ hợp 3 môn."],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Điểm ĐGNL HCM","fields":{"audience":[],"conditions":["Thí sinh có điểm thi ĐGNL đạt từ 600 điểm trở lên."],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false}],"common":{"audience":[],"conditions":[],"form