iv":null}},"notes":[]}],"tuition":{"uni_code":"DHT","year":2026,"min_mil":15.4,"max_mil":19.7,"unit_note":null,"text":"Dự kiến","source_url":"https://giaoduc.net.vn/nam-nay-3-dai-hoc-vung-tuyen-sinh-hon-63900-chi-tieu-hoc-phi-cao-nhat-65-trieu-dongnam-post261051.gd","source_type":"press","confidence":"medium"},"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-khoa-hoc-hue-DHT.html","dean":{"year":2025,"methods_year":2025,"quota":[],"methods":[{"name":"Điểm thi THPT","fields":{"audience":[],"conditions":[],"formula":["Điểm các môn trong tổ hợp xét tuyển là điểm thi tốt nghiệp THPT năm 2025."],"bonus":[],"quota":[],"notes":["Xét tuyển dựa vào kết quả thi tốt nghiệp THPT."]},"shared":false},{"name":"Điểm học bạ","fields":{"audience":["Thí sinh có thể tham dự kiểm tra môn năng khiếu nhiều lần và nhận giấy chứng nhận kết quả kiểm tra cho mỗi đợt kiểm tra.","Thí sinh được sử dụng kết quả kiểm tra môn năng khiếu cao nhất để xét tuyển.","Thí sinh có thể sử dụng kết quả thi môn năng khiếu Vẽ mỹ thuật năm 2025 của các cơ sở giáo dục đại học khác gồm: Trường Đại học Kiến trúc Hà Nội.","Thí sinh phải nộp kết quả thi môn năng khiếu Vẽ mỹ thuật cho Hội đồng tuyển sinh Đại học Huế để phục vụ việc xét tuyển."],"conditions":[],"formula":["Điểm các môn trong tổ hợp môn xét tuyển là điểm trung bình chung (làm tròn đến một chữ số thập phân) của 4 học kỳ gồm: học kỳ 1, học kỳ 2 năm học lớp 11, học kỳ 1, học kỳ 2 năm lớp 12 của mỗi môn.","Đối với điểm các môn văn hóa dựa vào kết quả thi tốt nghiệp THPT, điểm các môn trong tổ hợp môn xét tuyển là điểm thi tốt nghiệp THPT năm 2025.","Đối với điểm môn văn hóa dựa vào kết quả học tập cấp THPT (học bạ), điểm các môn trong tổ hợp môn xét tuyển là điểm trung bình chung (làm tròn đến một chữ số thập phân) của 4 học kỳ gồm: học kỳ 1, học kỳ 2 năm học lớp 11, học kỳ 1…"],"bonus":[],"quota":[],"notes":["Xét tuyển dựa vào kết quả học tập cấp THPT (học bạ)","Xét tuyển dựa vào kết quả thi tốt nghiệp THPT hoặc kết quả học tập cấp THPT (học bạ) kết hợp với thi năng khiếu.","Trường Đại học Khoa học áp dụng phương thức xét tuyển dựa vào kết quả thi tốt nghiệp THPT năm 2025 hoặc kết quả học tập cấp THPT (học bạ) kết hợp với kiểm tra năng khiếu năm 2025 cho 1 ngành sau.","Ngoài các môn văn hóa, thí sinh phải kiểm tra môn năng khiếu Vẽ mỹ thuật (thí sinh được chọn một trong hai đề Vẽ tĩnh vật hoặc Vẽ đầu tượng).","Môn năng khiếu Vẽ mỹ thuật sẽ được kiểm tra theo quy định của Trường Đại học Khoa học.","Việc kiểm tra môn năng khiếu Vẽ mỹ thuật có thể được tổ chức nhiều đợt tại Trường Đại học Khoa học và một số tỉnh/thành phố lân cận theo thông báo của Trường Đại học Khoa học.","Trường Đại học Xây dựng Hà Nội.","Trường Đại học Bách khoa, Đại học Đà Nẵng.","Trường Đại học Kiến trúc Thành phố Hồ Chí Minh.","Trường Đại học Bách Khoa, Đại học Quốc Gia Thành phố Hồ Chí Minh để xét tuyển.","Thí sinh phải dự thi và có điểm môn Vẽ mỹ thuật năm 2025 lớn hơn hoặc bằng 5,0 điểm."]},"shared":false},{"name":"Điểm ĐGNL HCM","fields":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Xét tuyển dựa vào điểm đánh giá năng lực của Đại học Quốc gia Thành phố Hồ Chí Minh.","Trường Đại học Khoa học xét tuyển dựa vào điểm đánh giá năng lực năm 2025 của Đại học Quốc gia Thành phố Hồ Chí Minh."]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Thí sinh đạt một trong các yêu cầu sau được ưu tiên xét tuyển thẳng vào Trường Đại học Khoa học, Đại học Huế theo thứ tự."],"conditions":[],"formula":["Thí sinh đạt giải nhất, nhì, ba trong các cuộc thi học sinh giỏi cấp tỉnh, thành phố trực thuộc trung ương các năm 2024, 2025 (môn đoạt giải phải thuộc tổ hợp môn xét tuyển)","Thí sinh có chứng chỉ Tiếng Anh (còn thời hạn đến ngày nộp hồ sơ đăng ký xét tuyển) IELTS >= 5,0 hoặc TOEFL iBT >= 60 hoặc TOEFL ITP >= 500 đối với những ngành mà tổ hợp môn xét tuyển có môn Tiếng Anh.","Thí sinh của các trường THPT chuyên trên cả nước có điểm học bạ theo tổ hợp xét tuyển đạt từ 24,0 điểm trở lên.","Thí sinh của các trường THPT kết quả học tập năm học lớp 12 đạt mức Tốt, đồng thời phải học và có điểm học bạ năm lớp 12 theo tổ hợp xét tuyển."],"bonus":[],"quota":[],"notes":["Xét tuyển thẳng theo quy định của Bộ Giáo dục và Đào tạo.","Trường Đại học Khoa học xét tuyển thẳng theo quy định của Quy chế tuyển sinh đại học, tuyển sinh cao đẳng ngành Giáo dục mầm non hiện hành của Bộ Giáo dục và Đào tạo.","Xét tuyển theo ưu tiên theo đề án tuyển sinh Trường Đại học Khoa học, Đại học Huế."]},"shared":true},{"name":"Điểm xét tuyển kết hợp","fields":{"audience":["Xét tuyển dựa vào kết quả thi tốt nghiệp THPT hoặc kết quả học tập cấp THPT (học bạ) kết hợp với thi năng khiếu."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false}],"common":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Đối với ngành Kiến trúc, thí sinh phải dự thi và có điểm môn Vẽ mỹ thuật năm 2025 lớn hơn hoặc bằng 5,0 điểm."]},"timeline":[],"documents":[],"post_id":28756,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-khoa-hoc-hue","modified":"2025-12-22T08:39:18","school_name":"Trường Đại Học Khoa Học Huế","province":"Thành phố Huế","groups":["Kỹ thuật"],"taxonomy_years":["2025"],"method_tags":["TN THPT","VACT"]}}