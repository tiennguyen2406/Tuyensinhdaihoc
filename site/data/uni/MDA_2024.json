tes":[]},{"program_code":"7580212","program_name":"Kỹ thuật Tài nguyên nước","major_code":"7580212","program_type":"CHUAN","combos":"A00;A01;C04;D01","scores":{"HOCBA":{"score":18.0,"scale":30.0,"equiv":null}},"notes":[]},{"program_code":"7850202","program_name":"An toàn, vệ sinh lao động","major_code":"7850202","program_type":"CHUAN","combos":"A00;A01;B00;D01","scores":{"HOCBA":{"score":20.0,"scale":30.0,"equiv":null}},"notes":[]}],"tuition":null,"tuition_extra":{"uni_code":"MDA","name":"Trường Đại học Mỏ – Địa chất","school_year":"2026–2027","year_start":2026,"scope":"2026–2027","summary":"Chính quy 513.100–635.900 đồng/tín chỉ theo nhóm; kỹ sư tài năng miễn học phí năm 2026–2027.","items":[{"name":"Kinh doanh/quản lý/pháp luật (mã 7340201 trong bảng nguồn)","amount":"526.400","unit":"đ/tín chỉ"},{"name":"Khoa học sự sống/tự nhiên","amount":"513.100","unit":"đ/tín chỉ"},{"name":"Toán/CNTT/công nghệ/kỹ thuật/sản xuất/xây dựng/nông lâm/thủy sản/thú y","amount":"568.200","unit":"đ/tín chỉ"},{"name":"Sức khỏe","amount":"635.900","unit":"đ/tín chỉ"},{"name":"Kỹ sư tài năng","amount":"Miễn học phí năm 2026–2027","unit":"(đơn giá công bố 624.700 đ/tín chỉ)"}],"flags":["theo_tin_chi"],"only_major":null,"evidence":"official","note":"Bảng chính thức trong thông báo 03/07/2026. Không dùng mức cũ 454.100–499.100 đồng/tín chỉ.","sources":["https://ctsv.humg.edu.vn/vi/news/thong-bao/thong-bao-ve-muc-thu-hoc-phi-nam-hoc-2026-2027-200.html","https://ctsv.humg.edu.vn/uploads/news/2026_07/image.png"],"auto_ok":false,"manual_override":true},"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-mo-dia-chat-MDA.html","dean":{"year":2026,"methods_year":2025,"quota":[],"methods":[{"name":"Điểm thi THPT","fields":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Phương thức: Xét tuyển dựa vào kết quả thi tốt nghiệp THPT."]},"shared":true},{"name":"Điểm học bạ","fields":{"audience":[],"conditions":["Xét tuyển dựa vào kết quả học tập tại THPT.","Thí sinh tốt nghiệp THPT và kết quả học tập trong 6 học kỳ (Lớp 10, 11, và lớp 12).","Xét tuyển thí sinh theo học bạ với các thí sinh đạt hạnh kiểm xếp loại Khá trở lên.","Tổng điểm trung bình các môn học theo khối thi của 6 học kỳ THPT: đạt từ 18 điểm trở lên."],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Chứng chỉ quốc tế, hồ sơ năng lực học tập","fields":{"audience":[],"conditions":["Phương thức: Chứng chỉ quốc tế, hồ sơ năng lực học tập.","Thí sinh có điểm trung bình chung (TBC) học tập từng năm học lớp 10, 11, 12 đạt 7,0 trở lên và đáp ứng một trong các điều kiện sau.","Được chọn tham dự kỳ thi HSG Quốc gia do Bộ GD&ĐT tổ chức hoặc đoạt giải Nhất, Nhì, Ba hoặc Khuyến khích trong kỳ thi chọn HSG cấp tỉnh/thành phố do Sở GD&ĐT tổ chức các môn Toán, Lý, Hóa, Sinh, Tin, Ngoại ngữ…","Có ít nhất 1 trong các chứng chỉ Quốc tế sau: SAT, ACT…","Được chọn tham dự cuộc thi Đường lên đỉnh Olympia do Đài Truyền hình Việt Nam tổ chức từ vòng thi tháng trở lên.","Học sinh hệ chuyên (gồm chuyên Toán, Lý, Hóa, Sinh, Tin học, Ngoại ngữ) của các trường THPT và THPT chuyên trên toàn quốc, các lớp chuyên, hệ chuyên thuộc các Trường đại học, Đại học quốc gia, Đại học vùng."],"formula":["Tiêu chí tiếng Anh : Thí sinh có chứng chỉ tiếng Anh VSTEP hoặc chứng chỉ tiếng Anh quốc tế (đăng ký xác thực trên hệ thống) có thể quy đổi thành điểm môn tiếng Anh khi xét tuyển theo điểm thi tốt nghiệp THPT (tổ hợp A01, D01, D04, D07)"],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Điểm ĐGNL HN","fields":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Điểm Đánh giá Tư duy","fields":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Điểm ĐGNL HCM","fields":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Phương thức: Xét tuyển thẳng HSG theo kết quả học THPT, HSG cấp quốc gia, quốc tế.","Thí sinh tốt nghiệp THPT năm 2025, đạt thành tích cao trong kỳ thi học sinh giỏi (HSG), cuộc thi Khoa học kỹ thuật (KHKT) do Bộ Giáo dục và Đào tạo tổ chức.","Thí sinh được triệu tập tham dự kỳ thi chọn đội tuyển quốc gia dự thi Olympic quốc tế và khu vực, hoặc đoạt giải Nhất, Nhì, Ba trong kỳ thi chọn HSG Quốc gia các môn văn hóa được xét tuyển thẳng vào các ngành học phù hợp với môn đạt giải.","Thí sinh trong đội tuyển Quốc gia tham dự cuộc thi KHKT Quốc tế hoặc đạt giải Nhất, Nhì, Ba trong cuộc thi KHKT cấp Quốc gia do Bộ GD&ĐT tổ chức được xét tuyển thẳng vào ngành học phù hợp với lĩnh vực đề tài đã đăng ký dự thi."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false}],"common":{"audience":[],"conditions":[],"formula":["Quy đổi CCTAQT."],"bonus":["Quy định về quy đổi điểm chứng chỉ IELTS (Academic) thành điểm tiếng Anh để xét tuyển các tổ hợp A01, D01, D04, D07, D10 và mức điểm thưởng."],"quota":[],"notes":["Phương thức: Sử dụng kết quả đánh giá tư duy của ĐH BKHN, ĐHQG."]},"timeline":[],"documents":[],"post_id":28604,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-mo-dia-chat","modified":"2025-12-19T08:15:23","school_name":"Trường Đại Học Mỏ Địa Chất","province":"Thành phố Hà Nội","groups":["Kỹ thuật"],"taxonomy_years":["2025"],"method_tags":["HSA","TN THPT","TSA","VACT"]}}