"Điểm thi THPT","fields":{"audience":["Mọi công dân không phân biệt dân tộc, tôn giáo, tín ngưỡng giới tính, nguồn gốc gia đình, địa vị xã hội hoặc hoàn cảnh kinh tế, nếu có đủ các điều kiện sau đây đều được xét tuyển vào Trường Đại học Công nghệ Sài Gòn.","Đã tốt nghiệp trung học phổ thông (THPT), theo hình thức giáo dục chính quy hoặc giáo dục thường xuyên, trung cấp chuyên nghiệp, trung học nghề, trung cấp nghề, hoặc tương đương.","Người đã tốt nghiệp trung cấp nghề phải là người đã tốt nghiệp trung học cơ sở (THCS), đã học đủ khối lượng kiến thức và thi tốt nghiệp các môn văn hóa THPT đạt yêu cầu theo quy định của Bộ Giáo dục và Đào tạo (Bộ GDĐT)","Có đủ sức khỏe để học tập theo quy định hiện hành.","Quân nhân tại ngũ sắp hết hạn nghĩa vụ quân sự theo quy định, nếu được Thủ trưởng từ cấp trung đoàn trở lên cho phép, thì được xét tuyển theo nguyện vọng cá nhân, nếu trúng tuyển phải nhập học ngay năm đó…"],"conditions":[],"formula":["Điểm thi tốt nghiệp THPT của 3 môn trong tổ hợp xét tuyển.","Đây là tổ hợp gồm điểm thi trong kỳ thi tốt nghiệp THPT của 3 môn thi."],"bonus":[],"quota":[],"notes":["Xét điểm thi tốt nghiệp THPT năm 2025.","Phải có ít nhất một môn Toán, hoặc Văn cho các ngành thuộc khối Kinh tế, quản trị.","Luật: Thiết kế Mỹ thuật và Du lịch Lấy điểm cao nhất trong 2 môn Toán – Ngữ văn.","Tổ hợp các môn xét tuyển có thể khác nhau do thay đổi chương trình theo bộ sách giáo khoa cũ năm 2006 và bộ sách giáo khoa mới năm 2018.","Hoặc, do chọn lựa môn học tự chọn của thí sinh."]},"shared":true},{"name":"Điểm học bạ","fields":{"audience":["Mọi công dân không phân biệt dân tộc, tôn giáo, tín ngưỡng giới tính, nguồn gốc gia đình, địa vị xã hội hoặc hoàn cảnh kinh tế, nếu có đủ các điều kiện sau đây đều được xét tuyển vào Trường Đại học Công nghệ Sài Gòn.","Đã tốt nghiệp trung học phổ thông (THPT), theo hình thức giáo dục chính quy hoặc giáo dục thường xuyên, trung cấp chuyên nghiệp, trung học nghề, trung cấp nghề, hoặc tương đương.","Người đã tốt nghiệp trung cấp nghề phải là người đã tốt nghiệp trung học cơ sở (THCS), đã học đủ khối lượng kiến thức và thi tốt nghiệp các môn văn hóa THPT đạt yêu cầu theo quy định của Bộ Giáo dục và Đào tạo (Bộ GDĐT)","Có đủ sức khỏe để học tập theo quy định hiện hành.","Quân nhân tại ngũ sắp hết hạn nghĩa vụ quân sự theo quy định, nếu được Thủ trưởng từ cấp trung đoàn trở lên cho phép, thì được xét tuyển theo nguyện vọng cá nhân, nếu trúng tuyển phải nhập học ngay năm đó…"],"conditions":[],"formula":["Tổ hợp xét tuyển: Nhóm 1: ĐTB năm Lớp 10+ ĐTB năm Lớp 11 + ĐTB năm Lớp 12.","Nhóm 2: ĐTB năm Lớp 12 của 3 môn trong tổ hợp xét tuyển.","Đây là tổ hợp gồm điểm trung bình cả năm Lớp 12 THPT của 3 môn học."],"bonus":[],"quota":[],"notes":["Xét tuyển bằng Học bạ.","Phải có ít nhất một môn Toán, hoặc Văn cho các ngành thuộc khối Kinh tế, quản trị;Luật.","Thiết kế Mỹ thuật và Du lịch Lấy điểm cao nhất trong 2 môn Toán – Ngữ văn.","Tổ hợp các môn xét tuyển có thể khác nhau do thay đổi chương trình theo bộ sách giáo khoa cũ năm 2006.","Bộ sách giáo khoa mới năm 2018. hoặc, do chọn lựa môn học tự chọn của thí sinh."]},"shared":true},{"name":"Điểm ĐGNL HCM","fields":{"audience":[],"conditions":[],"formula":["Tổ hợp xét tuyển: Điểm thi Đánh giá năng lực do Đại học Quốc gia tổ chức năm 2025.","Quy đổi về thang điểm 30."],"bonus":[],"quota":[],"notes":["Xét tuyển bằng Điểm thi đánh giá năng lực năm 2025.","(ĐGNL_ĐHQG TPHCM).","Thang điểm: 1.200."]},"shared":false}],"common":{"audience":[],"conditions":["Ưu tiên xét tuyển thí sinh có chứng chỉ ngoại ngữ quốc tế: Trình độ tương đương trình độ bậc 3/6 khung năng lực ngoại ngữ Việt Nam trở lên."],"formula":[],"bonus":["Điểm cộng lần lượt là 1,00 điểm."],"quota":[],"notes":["Thang điểm: 30 điểm.","Tiếp theo lấy điểm cao nhất nhì của môn Toán/Văn và các môn còn lại.","Phải có môn Toán cho các ngành thuộc khối Kỹ thuật Công nghệ.","Lấy điểm môn Toán.","Tiếp theo lấy điểm cao nhất nhì của các môn còn lại.","Chứng chỉ phải còn trong thời hạn 2 năm tính đến ngày xét tuyển.","Tối đa là 2,00 điểm."]},"timeline":[],"documents":[],"post_id":28822,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-cong-nghe-sai-gon","modified":"2025-12-22T08:47:48","school_name":"Trường Đại Học Công Nghệ Sài Gòn","province":"Thành phố Hồ Chí Minh","groups":["Kỹ thuật"],"taxonomy_years":["2025"],"method_tags":["TN THPT","VACT"]}}