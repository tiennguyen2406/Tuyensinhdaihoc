,"conditions":[],"formula":["Điểm xét tuyển là tổng điểm trung bình 3 năm cấp THPT của 3 môn trong tổ hợp xét tuyển (có nhân trọng số) được quy đổi về thang điểm 30.","Các tổ hợp xét tuyển được tính tương đương nhau."],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Điểm ĐGNL HCM","fields":{"audience":["Thí sinh tốt nghiệp THPT và có kết quả kỳ thi ĐGNL năm 2025 do ĐHQG TPHCM tổ chức, đạt ngưỡng đảm bảo chất lượng đầu vào do Trường quy định (sẽ công bố sau)."],"conditions":[],"formula":["Điểm xét tuyển (ĐXT)= Điểm tổ hợp bài thi ĐGNL, quy về thang điểm 30 + Điểm cộng (nếu có) + Điểm ưu tiên (nếu có)"],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Điểm Đánh giá Tư duy","fields":{"audience":["Thí sinh tốt nghiệp THPT và có kết quả kỳ thi Đánh giá tư duy năm 2025 do ĐHBKHN tổ chức, đạt ngưỡng đảm bảo chất lượng đầu vào do Trường quy định (sẽ công bố sau)."],"conditions":[],"formula":["Điểm xét tuyển (ĐXT)= Điểm thi ĐGTD, quy về thang điểm 30 + Điểm cộng (nếu có) + Điểm ưu tiên (nếu có)"],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Xét tuyển thẳng theo quy định của bộ GD&DT.","Xét tuyển theo phương thức xét tuyển riêng.","Anh hùng lao động, Anh hùng lực lượng vũ trang nhân dân, Chiến sĩ thi đua toàn quốc.","Thí sinh đạt giải Nhất, Nhì, Ba, Khuyến khích (Giải Tư) tại cuộc thi học sinh giỏi các môn Toán, Vật lý, Hoá học, Sinh học, Tin học cấp tỉnh, thành phố trực thuộc trung ương.","Thời gian đạt giải không quá 3 năm tính tới thời điểm xét tuyển.","Thí sinh đạt giải Nhất, Nhì, Ba, Khuyến khích (Giải Tư) tại cuộc thi Khoa học kỹ thuật cấp tỉnh, thành phố trực thuộc trung ương.","Thí sinh được công nhận tốt nghiệp trung học phổ thông năm 2025 thuộc các đối tượng sau được Hội đồng tuyển sinh Trường sẽ xem xét, tuyển thẳng vào học ngành đăng ký xét tuyển căn cứ trên hồ sơ đăng ký của thí sinh, bao gồm.","Thí sinh là người khuyết tật nặng có giấy xác nhận khuyết tật của cơ quan có thẩm quyền cấp theo quy định, có khả năng học theo một số ngành do cơ sở đào tạo quy định nhưng không có khả năng dự tuyển theo phương thức tuyển sinh bình thường.","Thí sinh là người dân tộc thiểu số rất ít người theo quy định hiện hành của Chính phủ và thí sinh 20 huyện nghèo biên giới, hải đảo, thuộc khu vực Tây Nam Bộ.","Thí sinh là người nước ngoài phải đạt chuẩn năng lực ngôn ngữ theo yêu cầu của chương trình, ngành đào tạo phù hợp với quy định của Bộ GDĐT.","Thí sinh có thể đăng ký tuyển thẳng vào nhiều ngành khác nhau, theo thứ tự ưu tiên.","Thí sinh chỉ trúng tuyển vào 1 nguyện vọng ưu tiên cao nhất có thể trong số các nguyện vọng đăng ký."],"conditions":["Thí sinh có nơi thường trú từ 3 năm trở lên, học 3 năm và tốt nghiệp trung học phổ thông tại các huyện nghèo (học sinh học phổ thông dân tộc nội trú tính theo nơi thường trú) theo quy định của Chính phủ, Thủ tướng Chính phủ."],"formula":[],"bonus":[],"quota":["Xét theo thứ tự giải từ cao xuống thấp cho đến khi đủ chỉ tiêu và ưu tiên từ nguyện vọng 1 cho đến hết."],"notes":["Xét tuyển vào ngành đúng trước, sau đó xét tuyển vào ngành gần.","Mỗi thí sinh trúng tuyển 1 nguyện vọng sẽ không được xét tuyển các nguyện vọng tiếp theo.","Đối với mỗi thí sinh, nếu ĐKXT vào nhiều ngành thì việc xét tuyển được thực hiện theo thứ tự ưu tiên của các nguyện vọng."]},"shared":false},{"name":"Xét tuyển tài năng","fields":{"audience":["Nhóm 1: Thí sinh đoạt giải khuyến khích trong kỳ thi chọn học sinh giỏi quốc gia hoặc giải khuyến khích (giải tư) kỳ thi khoa học, kỹ thuật cấp quốc gia.","Thời gian đoạt giải không quá 3 năm tính tới thời điểm xét tuyển.","Nhóm 2: Thí sinh đoạt giải nhất, nhì, ba, khuyến khích (giải tư) tại cuộc thi học sinh giỏi cấp tỉnh, thành phố trực thuộc trung ương.","Nhóm 3: Thí sinh đoạt giải nhất, nhì, ba, khuyến khích (giải tư) tại cuộc thi khoa học, kỹ thuật cấp tỉnh, thành phố trực thuộc trung ương."],"conditions":[],"formula":["Điểm xét tuyển: Điểm xét tuyển (ĐXT) = Điểm quy đổi (xem Bảng 3) + Điểm cộng (nếu có) + Điểm ưu tiên (nếu có)","Điểm quy đổi theo phương thức xét tuyển tài năng."],"bonus":[],"quota":[],"notes":[]},"shared":false}],"common":{"audience":[],"conditions":["Thí sinh đã tốt nghiệp THPT, đạt ngưỡng chất lượng đầu vào do Trường quy định (sẽ thông báo sau)"],"formula":["Điểm xét tuyển (ĐXT) = Tổng điểm 3 môn thuộc tổ hợp xét tuyển với hệ số tương ứng mỗi môn, quy về thang điểm 30 + Điểm cộng (nếu có) + Điểm ưu tiên (nếu có)"],"bonus":[],"quota":[],"notes":["Điểm xét tuyển."]},"timeline":[{"date":"25/5/2025","event":"Đăng ký dự thi"},{"date":"31/5/2025","event":"Tập trung"},{"date":"02/6/2025","event":"Thi: 1"}],"documents":["Lệ phí đăng ký và dự thi: 400.000 đ/hồ sơ"],"post_id":28494,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-bach-khoa-da-nang","modified":"2025-12-22T08:08:40","school_name":"Trường Đại Học Bách Khoa Đà Nẵng","province":"Thành phố Đà Nẵng","groups":["Kỹ thuật"],"taxonomy_years":["2025"],"method_tags":["TN THPT","TSA","VACT"]}}