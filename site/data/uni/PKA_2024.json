":150.0,"equiv":null},"DGTD":{"score":50.0,"scale":100.0,"equiv":null}},"notes":[]},{"program_code":"VEE3","program_name":"Kỹ thuật phần mềm ô tô","major_code":"7480108","program_type":"CHUAN","combos":"A00;A01;A10;D01","scores":{"THPT":{"score":19.0,"scale":30.0,"equiv":null},"HOCBA":{"score":22.0,"scale":30.0,"equiv":null},"DGNL_HN":{"score":70.0,"scale":150.0,"equiv":null},"DGTD":{"score":50.0,"scale":100.0,"equiv":null}},"notes":[]}],"tuition":{"uni_code":"PKA","year":2026,"min_mil":28.0,"max_mil":128.0,"unit_note":null,"text":"Tùy ngành; Y khoa cao nhất","source_url":"https://tuyensinhso.vn/chua-phan-loai/hien-co-gan-120-truong-dai-hoc-cong-bo-hoc-phi-nam-2026-c430564.html","source_type":"aggregator","confidence":"medium"},"tuition_extra":null,"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-phenikaa-PKA.html","dean":{"year":2026,"methods_year":2026,"quota":["Đại học Phenikaa công bố thông tin tuyển sinh năm 2026, theo đó Đại học tuyển sinh 15.491 chỉ tiêu cho 80 ngành/chương trình đào tạo với 5 phương thức xét tuyển."],"methods":[{"name":"Điểm thi THPT","fields":{"audience":[],"conditions":[],"formula":["Điểm xét tuyển : là tổng điểm các môn thi của tổ hợp xét tuyển ứng với ngành do thí sinh đăng ký.","Tổng điểm được tính trên thang điểm 30.","Điểm xét tuyển = Điểm tổ hợp xét tuyển + Điểm ưu tiên.","Đại học Phenikaa sử dụng kết quả quy đổi điểm ngoại ngữ đối với thí sinh được miễn thi tốt nghiệp THPT năm 2026 để xét tuyển đối với phương thức xét kết quả thi THPT năm 2026."],"bonus":["Cộng điểm đối tượng ưu tiên, khu vực ưu tiên."],"quota":[],"notes":["Xét tuyển dựa vào kết quả kỳ thi tốt nghiệp THPT năm 2026."]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Xét tuyển thẳng theo Quy chế tuyển sinh năm 2026 của Bộ Giáo dục và Đào tạo."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Điểm ĐGNL HN","fields":{"audience":["Điều kiện chung.","Đối với phương thức 2, 3, 4, 5: Điểm xét tuyển dựa vào kết quả học tập của 6 học kì (lớp 10, lớp 11 và lớp 12)","Điểm môn 2, 3 tương tự môn 1.","Ngưỡng đảm bảo chất lượng đối với thí sinh đăng ký xét tuyển thuộc lĩnh vực pháp luật: Chuẩn đầu vào các chương trình đào tạo thuộc khối ngành Luật được xác định trên cơ sở kết quả các kỳ thi, xét tuyển hoặc hình thức đánh giá khác…","Quy tắc quy đổi tương đương điểm trúng tuyển giữa các phương thức xét tuyển: Đại học thông báo sau, theo hướng dẫn của Bộ Giáo dục và Đào tạo."],"conditions":["Y khoa, Răng – Hàm – Mặt, Y học cổ truyền, Dược học: 80/150 điểm trở lên đồng thời đạt ngưỡng đảm bảo chất lượng theo quy định của Bộ GD&ĐT.","Điều dưỡng, Hộ sinh, Kỹ thuật xét nghiệm y học, Kỹ thuật phục hồi chức năng, Kỹ thuật hình ảnh y học: 67/150 điểm trở lên đồng thời đạt ngưỡng đảm bảo chất lượng theo quy định của Bộ GD&ĐT.","Khối ngành còn lại và ngành Quản lý bệnh viện, Khoa học y sinh: 57/150 điểm trở lên."],"formula":["Thí sinh xét tuyển đạt mức điểm sàn tương ứng dựa vào 1 trong 3 tiêu chí sau: Kết quả thi Đánh giá năng lực (ĐGNL) của Đại học Quốc gia Hà Nội (thang điểm 150)"],"bonus":[],"quota":[],"notes":["Xét tuyển dựa vào kết quả thi đánh giá năng lực (ĐGNL) của Đại học Quốc gia Hà Nội."]},"shared":true},{"name":"Điểm Đánh giá Tư duy","fields":{"audience":[],"conditions":["Y khoa, Răng – Hàm – Mặt, Y học cổ truyền, Dược học: 56/100 điểm trở lên đồng thời đạt ngưỡng đảm bảo chất lượng theo quy định của Bộ GD&ĐT.","Điều dưỡng, Hộ sinh, Kỹ thuật xét nghiệm y học, Kỹ thuật phục hồi chức năng, Kỹ thuật hình ảnh y học: 46/100 điểm trở lên đồng thời đạt ngưỡng đảm bảo chất lượng theo quy định của Bộ GD&ĐT.","Khối ngành còn lại và ngành Quản lý bệnh viện, Khoa học y sinh: 40/100 điểm trở lên."],"formula":["Kết quả thi Đánh giá tư duy (ĐGTD) của Đại học Bách khoa Hà Nội (thang điểm 100): Khối ngành Sức khỏe."],"bonus":[],"quota":[],"notes":["Xét tuyển dựa vào kết quả thi đánh giá tư duy của Đại học Bách khoa Hà Nội (ĐGTD)"]},"shared":true},{"name":"Điểm ĐGNL ĐH Sư phạm HN","fields":{"audience":[],"conditions":["Y khoa, Răng – Hàm – Mặt, Y học cổ truyền, Dược học: 22.5/30 điểm trở lên đồng thời đạt ngưỡng đảm bảo chất lượng theo quy định của Bộ GD&ĐT.","Điều dưỡng, Hộ sinh, Kỹ thuật xét nghiệm y học, Kỹ thuật phục hồi chức năng, Kỹ thuật hình ảnh y học: 19/30 điểm trở lên đồng thời đạt ngưỡng đảm bảo chất lượng theo quy định của Bộ GD&ĐT.","Khối ngành còn lại và ngành Quản lý bệnh viện, Khoa học y sinh: 19/30 điểm trở lên."],"formula":["Kết quả kỳ thi SPT 2026 của Trường Đại học Sư phạm Hà Nội (thang điểm 30): Thí sinh có điểm tổ hợp xét tuyển đạt mức điểm sàn sau."],"bonus":[],"quota":[],"notes":["Xét tuyển dựa vào Kết quả kỳ thi SPT 2026 của Trường Đại học Sư phạm Hà Nội."]},"shared":true},{"name":"Điểm Đánh giá đầu vào V-SAT","fields":{"audience":[],"conditions":["Y khoa, Răng – Hàm – Mặt, Y học cổ truyền, Dược học: 240/450 điểm trở lên đồng thời đạt ngưỡng đảm bảo chất lượng theo quy định của Bộ GD&ĐT.","Điều dưỡng, Hộ sinh, Kỹ thuật xét nghiệm y học, Kỹ thuật phục hồi chức năng, Kỹ thuật hình ảnh y học: 202/450 điểm trở lên đồng thời đạt ngưỡng đảm bảo chất lượng theo quy định của Bộ GD&ĐT.","Khối ngành còn lại và ngành Quản lý bệnh viện, Khoa học y sinh: 202/450 điểm trở lên."],"formula":["Thí sinh có điểm tổ hợp xét tuyển đạt mức điểm sàn như sau: Kỳ thi đánh giá đầu vào Đại học V-SAT (thang điểm 450)"],"bonus":[],"quota":[],"notes":["Xét tuyển dựa vào kết quả Kỳ thi V-SAT do đơn vị khác tổ chức để xét tuyển."]},"shared":true},{"name":"Điểm xét tuyển kết hợp","fields":{"audience":[],"conditions":["Khối ngành Sức khỏe (trừ ngành Quản lý bệnh viện và Khoa học y sinh): Đạt ngưỡng đảm bảo chất lượng theo quy định của Bộ GD&ĐT.","Thời gian đạt giải không quá 3 năm tính tới thời điểm xét tuyển.","Đối tượng 2: Thí sinh đạt giải Nhất/Nhì/Ba trong cuộc thi “Học sinh, sinh viên với ý tưởng khởi nghiệp” cấp Tỉnh/Thành phố trở lên.","Đối tượng 3: Thí sinh đạt giải Nhất/Nhì/Ba trong cuộc thi “Khoa học kỹ thuật” cấp Tỉnh/Thành phố trở lên.","Đối tượng 4 : Thí sinh đạt giải Nhất/Nhì/Ba trong các cuộc thi văn nghệ – thể thao cấp Quốc gia trở lên."],"formula":["Thí sinh đăng ký xét tuyển ngoài đáp ứng được điều kiện chung (mục 6,4) cần phải có điểm tổ hợp xét tuyển học bạ đạt mức điểm sàn.","Đồng thời, thí sinh phải đạt có tổng điểm 3 môn thi tốt nghiệp trung học phổ thông tương ứng với tổ hợp xét tuyển (hoặc điểm thi của môn Toán, Ngữ văn và một môn khác) đạt tối thiểu 16 điểm theo thang điểm 30.","Đối tượng 1: Thí sinh đạt giải Nhất/Nhì/Ba/Khuyến khích kỳ thi Học sinh giỏi (HSG) cấp Tỉnh/Thành phố trở lên có môn đạt giải nằm trong tổ hợp môn xét tuyển đối với ngành/chương trình đào tạo đăng ký."],"bonus":[],"quota":[],"notes":["Xét tuyển kết hợp học bạ THPT và kết quả kỳ thi tốt nghiệp THPT.","Khối ngành còn lại và ngành Quản lý bệnh viện, Khoa học y sinh: 20,0 điểm.","Riêng thí sinh đạt giải môn Tin học được xét tuyển vào tất cả các ngành/chương trình đào tạo.","Các chứng chỉ quốc tế phải còn thời hạn sử dụng tính đến thời gian đăng ký xét tuyển của Đại học."]},"shared":true}],"common":{"audience":[],"conditions":["Điều kiện chung.","Đối với phương thức 2, 3, 4, 5: Điểm xét tuyển dựa vào kết quả học tập của 6 học kì (lớp 10, lớp 11 và lớp 12)","Điểm môn 2, 3 tương tự môn 1.","Đối với ngành Y khoa, Răng – Hàm – Mặt, Y học cổ truyền, Dược học và các ngành thuộc lĩnh vực pháp luật: Kết quả trung bình chung học tập được đánh giá mức tốt (học lực xếp loại từ giỏi trở lên) cấp THPT (hoặc tương đương) và tổng điểm 3…","Đối với ngành Điều dưỡng, Hộ sinh, Kỹ thuật xét nghiệm y học, Kỹ thuật phục hồi chức năng, Kỹ thuật hình ảnh y học: Kết quả trung bình chung học tập được đánh giá mức khá (học lực xếp loại từ khá trở lên) cấp THPT (hoặc tương đương) và…","Ngưỡng đảm bảo chất lượng đối với thí sinh đăng ký xét tuyển thuộc lĩnh vực pháp luật: Chuẩn đầu vào các chương trình đào tạo thuộc khối ngành Luật được xác định trên cơ sở kết quả các kỳ thi, xét tuyển hoặc hình thức đánh giá khác…","Thí sinh phải đạt tối thiểu 60% điểm đánh giá tối đa của thang điểm.","Khối ngành Sức khỏe."],"formula":["Điểm tổ hợp xét tuyển = Điểm môn 1 + Điểm môn 2 + Điểm môn 3.","Điểm xét tuyển = Điểm tổ hợp xét tuyển + Điểm ưu tiên + Điểm cộng (nếu có)","Điểm môn 1 = (Điểm TB môn 1 HK1 lớp 10 + Điểm TB môn 1 HK2 lớp 10 + Điểm TB môn 1 HK1 lớp 11 + Điểm TB môn 1 HK2 lớp 11 + Điểm TB môn 1 HK1 lớp 12 + Điểm TB môn 1 HK2 lớp 12)/6.","Quy tắc quy đổi tương đương điểm trúng tuyển giữa các phương thức xét tuyển: Đại học thông báo sau, theo hướng dẫn của Bộ Giáo dục và Đào tạo."],"bonus":["Điểm cộng: áp dụng với các đối tượng được xét điểm cộng."],"quota":[],"notes":["Tổng điểm 3 môn thi hoặc điểm xét tốt nghiệp THPT áp dụng cho năm thí sinh tốt nghiệp."]},"timeline":[{"date":"tháng 12","event":"Đợt bổ sung: theo quy định của Bộ"}],"documents":["1 Bản photo công chứng học bạ THPT (3 năm)","1 Bản photo công chứng CMND/CCCD (hai mặt)","1 Bản photo công chứng giấy chứng nhận tốt nghiệp tạm thời THPT năm 2026","1 Bản photo công chứng bằng tốt nghiệp THPT (áp dụng cho thí sinh tốt nghiệp trước năm 2026)","1 Bản photo công chứng các giấy tờ minh chứng thành tích (nếu có) như:","Giấy chứng nhận học sinh giỏi cấp Tỉnh/Thành phố trở lên","Giấy chứng nhận cuộc thi “Học sinh, sinh viên với ý tưởng khởi nghiệp” cấp Tỉnh/Thành phố trở lên","Chứng chỉ ngoại ngữ (nếu dùng xét tuyển)","1 Bản photo công chứng kết quả kỳ thi của một trong 4 kỳ thi (nếu xét tuyển bằng phương thức 3, 4):"],"post_id":28403,"source_url":"https://huongnghiep.hocmai.vn/de-an/dai-hoc-phenikaa","modified":"2025-12-22T07:52:13","school_name":"Đại Học Phenikaa","province":"Thành phố Hà Nội","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["HSA","TN THPT","TSA"]}}