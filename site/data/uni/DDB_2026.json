e":30.0,"equiv":null}},"notes":[]},{"program_code":"7850103","program_name":"Quản lý đất đai","major_code":"7850103","program_type":"CHUAN","combos":"A04;A06;A07;B02;C04;D10;X01;X21","scores":{"THPT":{"score":15.0,"scale":30.0,"equiv":null},"HOCBA":{"score":18.0,"scale":30.0,"equiv":null}},"notes":[]}],"tuition":{"uni_code":"DDB","year":2025,"min_mil":9.15,"max_mil":30.0,"unit_note":"305 nghìn–1 triệu đồng/tín chỉ, quy đổi theo tín chỉ × 30 tín chỉ/năm","text":"Mức năm 2025; chưa thấy công bố 2026–2027","source_url":"https://huongnghiep.hocmai.vn/tuyen-sinh-2025-dai-hoc-thanh-dong-ddb-cong-bo-de-an-tuyen-sinh-2025-27-nganh-hoc-bong-va-3-phuong-thuc-xet-tuyen","source_type":"aggregator","confidence":"low"},"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-thanh-dong-DDB.html","dean":{"year":2025,"methods_year":2025,"quota":[],"methods":[{"name":"Điểm thi THPT","fields":{"audience":["Xét tuyển theo kết quả thi tốt nghiệp THPT thuộc khối xét tuyển đạt ngưỡng đảm bảo chất lượng theo quy định của Bộ GDĐT và của Trường."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Điểm học bạ","fields":{"audience":["Thí sinh tốt nghiệp THPT hoặc tương đương, có điểm tổng kết cả năm lớp 12 hoặc cả năm của lớp 11 và kỳ 1 lớp 12 các môn thuộc khối xét tuyển ≥ 18 điểm."],"conditions":["Riêng đối với ngành Dược học và Y học cổ truyền, thí sinh có tổng điểm 3 môn học lớp 12 thuộc khối xét tuyển đạt 24,0 điểm trở lên, xếp loại học lực giỏi.","Ngành Điều dưỡng, Kỹ thuật xét nghiệm y học, Kỹ thuật hình ảnh y học thí sinh có tổng điểm 3 môn thuộc khối xét tuyển đạt 19,5 điểm trở lên, xếp loại học lực khá (theo Thông tư 08/2022/TT-BGDĐT, 06/6/2022 của Bộ GD&ĐT)."],"formula":[],"bonus":[],"quota":[],"notes":["Xét tuyển theo học bạ THPT.","Xét trúng tuyển từ thí sinh có điểm cao xuống cho đến khi đủ chỉ tiêu cho từng ngành."]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Xét tuyển thẳng và cấp học bổng toàn phần trong suốt khóa học cho học sinh đạt giải kỳ thi quốc gia và quốc tế."]},"shared":false}],"common":{"audience":[],"conditions":["Các điều kiện phụ sử dụng trong xét tuyển: Trong trường hợp phát sinh tình trạng số lượng thí sinh có điểm đăng ký xét tuyển bằng nhau lớn hơn chỉ tiêu tuyển sinh (vượt chỉ tiêu được phép tuyển) của khối ngành/ngành…"],"formula":["Điểm cộng đối với thí sinh đạt tổng điểm chuẩn từ 22,50 trở lên được xác định như sau: Điểm cộng = ((30−Tổngđiểmchuẩn)/7,5)","Quy định chênh lệch điểm xét tuyển giữa các tổ hợp: Trường xét tuyển theo điểm xét tuyển từ cao xuống thấp đến đủ chỉ tiêu của từng ngành, không có sự chênh lệch điểm giữa các tổ hợp môn xét tuyển trong ngành."],"bonus":["Điểm cộng, điểm thưởng, điểm khuyến khích (gọi chung là điểm cộng) đối với thí sinh có thành tích đặc biệt sẽ không vượt quá 10% mức điểm tối đa của thang điểm xét tuyển, tương đương tối đa là 3 điểm đối với thang điểm 30.","Quy định về điểm cộng trong tuyển sinh: Trường Đại học Thành Đông áp dụng điểm cộng đối với thí sinh có đủ liệu xét tuyển và hồ sơ minh chứng hợp lệ đáp ứng một trong các điều kiện sau.","Thí sinh tốt nghiệp THPT và có chứng chỉ Tiếng Anh TOEFL IBT từ 75/120 điểm hoặc IELTS từ 5.0/9,0 trở lên do cơ quan quốc tế có thẩm quyền cấp còn thời hạn hiệu lực sử dụng tính đến thời điểm nộp hồ sơ ĐKXT được cộng ba điểm (+3,0 điểm)…","Thí sinh tốt nghiệp THPT và đạt học lực giỏi cả ba năm: Lớp 10, lớp 11 và lớp 12 được cộng ba điểm (+3,0 điểm) vào tổng điểm xét tuyển chuẩn.","Thí sinh đáp ứng cùng lúc cả hai điều kiện trên chỉ được áp dụng một lần điểm cộng tối đa là cộng ba điểm (+3,0 điểm) vào tổng điểm xét tuyển chuẩn.","Nếu thí sinh thuộc diện được cộng điểm nhưng không nộp hồ sơ minh chứng tại Trường thì không được áp dụng điểm cộng trong tuyển sinh."],"quota":[],"notes":["Trường không sử dụng tiêu chí phụ riêng để xét tuyển ngoài các quy định trong Quy chế tuyển sinh của Bộ Giáo dục và Đào tạo và Quy chế tuyển sinh của Trường.","Các thí sinh thuộc diện trên phải thực hiện nộp hồ sơ minh chứng (bản sao có công chứng các chứng chỉ tiếng Anh hoặc Học bạ THPT có đầy đủ thông tin hợp lệ) trực tiếp tại Trường theo quy định.","Tiêu chí phân ngành, chương trình đào tạo (CSĐT tuyển sinh theo nhóm ngành)","Nhà trường không phân ngành học, theo đăng ký xét tuyển của thí sinh."]},"timeline":[{"date":"02/01/2025 – 20/07/2025","event":"Đợt 1: Đối với các thí sinh tốt nghiệp THPT năm 2024 trở về"},{"date":"25/7/2025 – 15/9/2025","event":"Đợt 2: Mốc thời gian"},{"date":"16/9/2025 – 31/12/2025","event":"Đợt 3: Mốc thời gian"}],"documents":["Phiếu đăng ký xét tuyển","2 Bản sao công chứng Học bạ THPT, Bằng tốt nghiệp THPT hoặc giấy chứng nhận tốt nghiệp tạm thời đối với thí sinh tốt nghiệp năm 2025","2 Bản sao công chứng Giấy khai sinh; Căn cước công dân","3 ảnh 3×4, 3 ảnh 2×3 (chụp không quá 6 tháng trở lại đây)"],"post_id":28692,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-thanh-dong","modified":"2025-12-19T08:36:16","school_name":"Trường Đại Học Thành Đông","province":"Thành phố Hải Phòng","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["TN THPT"]}}