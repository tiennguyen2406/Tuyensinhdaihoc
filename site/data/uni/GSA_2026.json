n."]},"shared":true},{"name":"PT2: Xét tuyển kết hợp giữa kết quả học tập bậc THPT và điều kiện điểm thi tốt nghiệp THPT 2026","fields":{"audience":[],"conditions":["Phương thức 2 (PT2 – xét tuyển kết hợp): Xét tuyển kết hợp giữa kết quả học tập bậc THPT và điều kiện điểm thi tốt nghiệp THPT năm 2026.","Xét tuyển kết hợp chỉ áp dụng với các thí sinh có điểm thi môn Toán trong kỳ thi tốt nghiệp THPT năm 2026 từ 5,0 trở lên (trừ ngành Toán ứng dụng, điểm thi môn Toán phải đạt từ 6,0 trở lên)."],"formula":["Điểm xét tuyển là tổng điểm ba môn học trong tổ hợp xét tuyển (đủ 3 năm học THPT) trong đó điểm môn Toán nhân 2.","Trong đó điểm từng môn của ba môn trong tổ hợp xét tuyển không có điểm trung bình môn nào (xét theo mỗi năm học) dưới 5,5 điểm."],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"PT3: Xét kết quả ĐGNL của ĐHQGHCM 2026","fields":{"audience":[],"conditions":["Thí sinh lưu ý chọn bài thi phù hợp với ngành đăng ký xét tuyển trong phần thi thứ ba (bài thi khoa học/bài thi tiếng Anh) và điều kiện xét tuyển trong phần ghi chú."],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false}],"common":{"audience":[],"conditions":[],"formula":[],"bonus":["Trừ ngành Ngôn ngữ Anh, điểm môn Tiếng Anh nhân 2 và điểm ưu tiên (nếu có)."],"quota":[],"notes":[]},"timeline":[],"documents":[],"post_id":28500,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-giao-thong-van-tai-co-so-2","modified":"2025-12-22T08:12:27","school_name":"Trường Đại Học Giao Thông Vận Tải (Cơ sở 2)","province":"Thành phố Hồ Chí Minh","groups":["Kỹ thuật"],"taxonomy_years":["2025"],"method_tags":["TN THPT","VACT"]}}