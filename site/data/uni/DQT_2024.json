ore":15.0,"scale":30.0,"equiv":null},"HOCBA":{"score":18.0,"scale":30.0,"equiv":null},"DGNL_HCM":{"score":500.0,"scale":1200.0,"equiv":null}},"notes":[]},{"program_code":"7810203","program_name":"Quản trị Khách sạn - Nhà hàng","major_code":"7810203","program_type":"CHUAN","combos":"C00;D01;D14;D15","scores":{"THPT":{"score":15.0,"scale":30.0,"equiv":null}},"notes":[]},{"program_code":"7810203","program_name":"Quản trị Khách sạn – Nhà hàng","major_code":"7810203","program_type":"CHUAN","combos":"C00;D01;D14;D15","scores":{"HOCBA":{"score":18.0,"scale":30.0,"equiv":null},"DGNL_HCM":{"score":500.0,"scale":1200.0,"equiv":null}},"notes":[]}],"tuition":null,"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-quang-trung-DQT.html","dean":{"year":2025,"methods_year":2025,"quota":["Trường Đại học Quang Trung tuyển 1.320 chỉ tiêu năm 2025 với 4 phương thức."],"methods":[{"name":"Điểm thi THPT","fields":{"audience":["Học sinh tốt nghiệp THPT trên cả nước."],"conditions":[],"formula":["Điểm xét tuyển bao gồm: kết quả điểm 3 bài thi/môn thi trong kỳ thi THPT năm 2025 theo tổ hợp đăng ký xét tuyển cho nhóm ngành/ngành/chương trình đào tạo.","Đối với ngành/nhóm ngành/chương trình không nhân hệ số: Điểm xét tuyển (ĐXT) = (M1 + M2 + M3) + Điểm ưu tiên (nếu có).","Đối với ngành Ngôn ngữ Anh, điểm bài thi môn tiếng Anh nhân hệ số 2: Điểm xét tuyển (ĐXT) = [(M1 + M2 + M3 × 2) × 3]/4 + Điểm ưu tiên (nếu có).","(Điểm xét tuyển được quy về tổng điểm 30, điểm số thập phân làm tròn theo quy định của Bộ Giáo dục và Đào tạo)."],"bonus":["Điểm ưu tiên theo khu vực và đối tượng của thí sinh (nếu có) được tính căn cứ vào Quy chế tuyển sinh năm 2025 của Bộ Giáo dục và Đào tạo."],"quota":[],"notes":["Được thực hiện theo “ Quy chế tuyển sinh trình độ đại học.","Tuyển sinh trình độ cao đẳng ngành Giáo dục Mầm non ” của Bộ Giáo dục và Đào tạo hiện hành."]},"shared":true},{"name":"Điểm học bạ","fields":{"audience":["Học sinh tốt nghiệp THPT trên cả nước."],"conditions":[],"formula":["Điểm xét tuyển = Điểm TBC học kỳ 1 và học kỳ 2 lớp 12 môn 1 + Điểm TBC học kỳ 1 và học kỳ 2 lớp 12 môn 2 + Điểm TBC học kỳ 1 và học kỳ 2 lớp 12 môn 3 + Điểm khu vực ưu tiên + Điểm đối tượng ưu tiên (nếu có)."],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Điểm ĐGNL HCM","fields":{"audience":[],"conditions":[],"formula":["Điểm xét tuyển được quy đổi theo khung quy đổi điểm của Bộ Giáo dục và Đào tạo.","Ngưỡng đầu vào này có thể sẽ được điều chỉnh sau khi thí sinh biết điểm thi của kỳ thi đánh giá năng lực đợt 2 năm 2025 của ĐHQG TP.Hồ Chí Minh sau khi được quy đổi theo khung quy đổi điểm của Bộ Giáo dục và Đào tạo."],"bonus":["Thí sinh tham dự kỳ thi đánh giá năng lực do ĐHQG-HCM tổ chức năm học 2024 – 2025, có điểm thi đánh giá năng lực + điểm ưu tiên theo quy định (nếu có) dự kiến đạt từ 500 điểm trở lên (theo thang điểm 1200) được nộp hồ sơ đăng ký xét tuyển."],"quota":[],"notes":[]},"shared":false},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Thí sinh thuộc đối tượng Xét tuyển thẳng theo Quy chế tuyển sinh của Bộ GD&ĐT dự tuyển vào các ngành theo nguyện vọng.","Học sinh Giỏi cấp tỉnh.","Học sinh trường chuyên.","Học sinh có chứng chỉ IELTS, SAT, ACT hoặc học lực Giỏi 3 năm THPT."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Xét tuyển thẳng."]},"shared":false}],"common":{"audience":[],"conditions":["Ngưỡng đảm bảo chất lượng đối với thí sinh đăng ký xét tuyển khối ngành Sức khỏe đạt ngưỡng đảm bảo chất lượng yêu cầu của Bộ GD&ĐT."],"formula":[],"bonus":[],"quota":[],"notes":[]},"timeline":[],"documents":[],"post_id":28732,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-quang-trung","modified":"2025-12-22T08:36:43","school_name":"Trường Đại Học Quang Trung","province":"Khác","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["TN THPT","VACT"]}}