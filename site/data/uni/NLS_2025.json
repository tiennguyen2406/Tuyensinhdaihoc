cope":"HK1 2024–2025","summary":"Đại trà, khóa 2020 trở về sau: khối ngành III 594.000 đồng/TC; IV 638.000; V 684.000; VII 638.000.","items":[],"flags":["nam_cu","theo_tin_chi"],"only_major":null,"evidence":"secondary","note":"Chưa đối chiếu gốc. Không sử dụng như mức 2026.","sources":["https://tuoitre.vn/plo/sinh-vien-bat-ngo-voi-muc-tang-hoc-phi-moi-truong-dh-nong-lam-tphcm-noi-gi-109814024.htm","https://cdn2.tuoitre.vn/plo/image/Uploaded/phamanh/2024_10_09/tang-hoc-phi-truong-dh-nong-lam-tphcm-4-7272.jpg","https://pkhtc.hcmuaf.edu.vn/vn/tin-tuc/thong-bao-muc-thu-hoc-phi-hoc-ky-1-nam-hoc-2026-2027-57953"],"auto_ok":false},"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-nong-lam-tphcm-NLS.html","dean":{"year":2026,"methods_year":2025,"quota":[],"methods":[{"name":"Điểm thi THPT","fields":{"audience":["Thí sinh tốt nghiệp Trung học phổ thông (THPT) có đủ điều kiện xét tuyển theo quy định của Bộ Giáo dục và Đào tạo và Đề án tuyển sinh trình độ đại học…","Thí sinh có thể đăng ký dự thi môn Năng khiếu mầm non tại Trường Đại học Sư phạmThành phố Hồ Chí Minh hoặc Trường Đại học Sư phạm Hà Nội để lấy điểm năng khiếu xét tuyển vào ngành Giáo dục Mầm non trình độ đại học, cao đẳng."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Xét tuyển dựa trên kết quả thi tốt nghiệp THPT năm 2025.","Riêng ngành Giáo dục mầm non (trình độ cao đẳng, đại học) xét tuyển dựa vào: kết quả điểm thitốt nghiệp THPT của hai môn Toán, Ngữ văn và điểm thi môn Năng khiếu."]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Tuyển thẳng và ưu tiên xét tuyển."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Điểm ĐGNL HCM","fields":{"audience":["Xét tuyển dựa trên kết quả kỳ thi Đánh giá năng lực do Đại học Quốcgia Thành phố Hồ Chí Minh tổ chức năm 2025."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Điểm học bạ","fields":{"audience":["Ương thức 5: Xét tuyển dựa trên kết quả học tập bậc THPT (học bạ).","Sử dụng điểmhọc bạ (trung bình của 4 học kỳ từ học kỳ 1 lớp 11 đến học kỳ 2 lớp 12, làm tròn đến 2 số lẻ thập phân) của mỗi môn trong tổ hợp xét tuyển.","Tại cơ sở Thành phố Hồ Chí Minh chỉ xét tuyển đối với các thí sinh tốt nghiệp THPT năm 2025.","Đối với xét tuyển ngành Giáo dục Mầm non (trình độ cao đẳng, đại học), sử dụng điểm học bạ của 2 môn Toán và Ngữ văn kết hợp với kết quả thi môn Năng khiếu.","Thí sinh có thể đăng ký dự thi môn Năng khiếu mầm non tại Trường Đại học Sư phạmThành phố Hồ Chí Minh hoặc Trường Đại học Sư phạm Hà Nội để lấy điểm năng khiếu xét tuyển vào ngành Giáo dục Mầm non trình độ đại học, cao đẳng."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Điểm xét tuyển kết hợp","fields":{"audience":["Xét tuyển dựa trên kết quả thi tốt nghiệp THPT năm 2025, bổ sung hoặc thay thế một môn trong tổ hợp xét tuyển bằng kết quả học tập bậc THPT (học bạ).","Không áp dụng đối với xét tuyển ngành Giáo dục mầm non (trình độ cao đẳng, đại học).Xét tuyển dựa vào điểm 2 (hai) môn thi tốt nghiệp THPT năm 2025 có trong tổ hợp xét tuyển và 1 (một) môn còn lại trong tổ hợp xét tuyển được sử dụng điểm…"],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Xét kết hợp với chứng chỉ quốc tế","fields":{"audience":["409 – Kết hợp kết quả thi tốt nghiệp THPT với chứng chỉ quốc tế để xét tuyển.","410 – Xét tuyển kết hợp kết quả họctập cấp THPT với chứng chỉ quốc tế để xét tuyển."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false}],"common":{"audience":[],"conditions":["Đối với điểm bài thi IELTS phải đạt từ 4,5 trở lên, đơn vị cấp chứng chỉ gồm: BritishCouncil (BC) hoặc International Development Program (IDP)","Điểm bài thi TOEFL ITP phải đạt từ 450 trở lên, đơn vị cấp chứng chỉ EducationalTesting Service (ETS)."],"formula":["Ngành Ngôn ngữ Anh (7220201): điểm môn Tiếng Anh được nhân đôi, cộng với điểm hai môn còn lại, quy về điểm 30.","Ngành Giáo dục mầm non (trình độ đại học: 7140201, trình độ cao đẳng: 51140201): điểm môn Năng khiếu được nhân đôi, cộng với điểm hai môn còn lại, quy về điểm 30."],"bonus":[],"quota":["Chỉ tiêu phân bổ cho từng chuyên ngành trong ngành (tối thiểu 30 sinh viên/chuyênngành)"],"notes":["Đối với các phương thức xét tuyển 3 và 5, thí sinh có thể sử dụng điểm chứng chỉ Tiếng Anh quốc tế (IELTS hoặc TOEFL ITP) còn giá trị sử dụng đến trước ngày thí sinh bắt đầu đăng ký xét tuyển theo quy định của Bộ Giáo dục và Đào tạo…","Tiêu chí phân ngành, chương trình đào tạo (CSĐT tuyển sinh theo nhóm ngành): Đối với các ngành đào có nhiều chuyên ngành, việc phân chuyên ngành đào tạo sẽ được thực hiệndựa trên các tiêu chí.","Nguyện vọng của sinh viên.","Kết quả học tập của sinh viên.","Đối với Chương trình tiên tiến, sinh viên cần đạt trình độ ngoại ngữ theo yêu cầu.","Các thông tin khác…"]},"timeline":[],"documents":[],"post_id":28590,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-nong-lam-tphcm","modified":"2025-12-19T08:13:27","school_name":"Trường Đại Học Nông Lâm TPHCM","province":"Thành phố Hồ Chí Minh","groups":["Nông/Lâm nghiệp"],"taxonomy_years":["2025"],"method_tags":["TN THPT","VACT"]}}