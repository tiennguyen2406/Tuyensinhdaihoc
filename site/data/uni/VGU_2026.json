"equiv":null},"CCQT_more":[{"score":0.7,"scale":30.0,"equiv":null},{"score":0.7,"scale":30.0,"equiv":null},{"score":165.0,"scale":1200.0,"equiv":null},{"score":1150.0,"scale":1200.0,"equiv":null},{"score":23.0,"scale":30.0,"equiv":null}],"KHAC":{"score":75.0,"scale":100.0,"equiv":null},"KHAC_more":[{"score":90.0,"scale":100.0,"equiv":null}]},"notes":["A-Level kết hợp với AS-Level hoặc IGCSE","ACT","GED"]},{"program_code":"7580201","program_name":"Kỹ thuật và Quản lý Xây dựng (BCE)","major_code":"7580201","program_type":"CHUAN","combos":"A00;A01;A04;AH2;AH3;C01;D01;D07;D21;D22;D23;D24;D25;D26;D27;D28;D29;D30;X06;X07;X26;X27","scores":{"THPT":{"score":18.0,"scale":30.0,"equiv":null},"HOCBA":{"score":7.65,"scale":30.0,"equiv":null},"CCQT":{"score":1150.0,"scale":1200.0,"equiv":null},"CCQT_more":[{"score":23.0,"scale":30.0,"equiv":null},{"score":28.0,"scale":30.0,"equiv":null},{"score":0.7,"scale":30.0,"equiv":null},{"score":0.7,"scale":30.0,"equiv":null},{"score":165.0,"scale":1200.0,"equiv":null}],"KHAC":{"score":90.0,"scale":100.0,"equiv":null},"KHAC_more":[{"score":75.0,"scale":100.0,"equiv":null}]},"notes":["A-Level kết hợp với AS-Level hoặc IGCSE","ACT","GED"]}],"tuition":{"uni_code":"VGU","year":2026,"min_mil":87.4,"max_mil":93.2,"unit_note":null,"text":"Tùy ngành","source_url":"https://tuyensinhso.vn/chua-phan-loai/hien-co-gan-120-truong-dai-hoc-cong-bo-hoc-phi-nam-2026-c430564.html","source_type":"aggregator","confidence":"medium"},"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-viet-duc-VGU.html","dean":{"year":2025,"methods_year":2025,"quota":["Năm nay, trường tuyển 1.075 chỉ tiêu cho 11 ngành theo 5 phương thức."],"methods":[{"name":"Điểm thi THPT","fields":{"audience":["Học sinh đã tốt nghiệp THPT hoặc đang học lớp 12 tại các trường Trung học phổ thông Việt Nam hoặc quốc tế.","Thí sinh đáp ứng các yêu cầu về tuyển sinh trình độ đại học của VGU và Bộ Giáo dục và Đào tạo."],"conditions":["Yêu cầu năng lực tiếng Anh đầu vào.","Có chứng chỉ tiếng Anh quốc tế IELTS học thuật từ 5,0 trở lên còn hiệu lực tại thời điểm nộp hồ sơ hoặc tương đương (các chứng chỉ tiếng Anh tương đương được quy định chi tiết tại Phụ lục 1 của Quy chế tuyển sinh đại học của VGU)","Đạt bài thi tiếng Anh bao gồm 4 kỹ năng nghe, nói, đọc, viết do VGU tổ chức.","Điểm trung bình môn tiếng Anh ba năm THPT đạt từ 7,5 trở lên (thang điểm 10).","Điều kiện này chỉ áp dụng cho Phương thức 2 và Phương thức 5.","Các trường hợp sau đây được miễn yêu cầu về năng lực tiếng Anh đầu vào: Thí sinh đến từ các quốc gia sử dụng tiếng Anh làm ngôn ngữ chính thức theo danh sách tại Phụ lục 2 Quy chế tuyển sinh đại học của VGU.","Thí sinh tốt nghiệp các chương trình THPT quốc tế dùng tiếng Anh làm ngôn ngữ giảng dạy và kiểm tra, đánh giá.","Thí sinh cần nộp văn bản của trường THPT cấp xác nhận chương trình được giảng dạy và kiểm tra, đánh giá hoàn toàn bằng tiếng Anh."],"formula":["Xét tuyển dựa vào tổng điểm 3 môn thi theo tổ hợp môn xét tuyển (khối xét tuyển) tương ứng được quy định cho các ngành đào tạo.","Thí sinh có thể sử dụng kết quả thi môn Vẽ mỹ thuật do các trường đại học khác tổ chức để xét tuyển theo các tổ hợp môn quy định (V00)"],"bonus":[],"quota":[],"notes":["CSE, ECE, MEN, SME, BCE, MEC: A00/C01/A01/D26/D29/D07/D21/D24.","EPE: B00/C01/A01/D26/D29/D07/D21/D24.","BFA, BBA, BSE: D01/D03/D05/C01/A01/D26/D29/D12.","ARC: A00/A01/D26/D29/V00/C01."]},"shared":false},{"name":"Điểm học bạ","fields":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Xét tuyển dựa trên kết quả học tập bậc THPT đối với các thí sinh sẽ tốt nghiệp các trường THPT tại Việt Nam trong năm tuyển sinh 2025.","Điểm xét tuyển dựa vào kết quả học bạ/bảng điểm ba năm học bậc THPT (Lớp 10, 11 và 12)."]},"shared":false},{"name":"Chứng chỉ quốc tế","fields":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Xét tuyển đối với các thí sinh có Bằng/Chứng chỉ tốt nghiệp THPT quốc tế (IBD, AS/A-Level/IGCSE, WACE, GED…) hoặc chứng chỉ bài thi năng lực quốc tế (SAT, TestAS, ACT…)","Bằng tốt nghiệp THPT quốc tế được công nhận theo quy định tại Quy chế tuyển sinh đại học của VGU."]},"shared":false},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Thành viên đội tuyển quốc gia tham dự kỳ thi Olympic quốc tế các môn: Toán học, Vật lý, Hóa học, Tin học hoặc đạt giải Nhất, Nhì, Ba kỳ thi Olympic Châu Á Thái Bình Dương bậc THPT các môn Toán học, Vật lý, Tin học.","Đạt giải Nhất, Nhì, Ba hoặc Khuyến khích trong kỳ thi học sinh giỏi bậc THPT cấp quốc gia hoặc cấp tỉnh/thành phố.","Thành viên đội tuyển quốc gia tham dự Hội thi khoa học, kỹ thuật quốc tế (ISEF) hoặc đạt giải Nhất, Nhì, Ba trong cuộc thi Khoa học kỹ thuật cấp quốc gia Việt Nam.","Kết quả dự án hoặc đề tài mà thí sinh đạt giải phải phù hợp với ngành đào tạo dự tuyển tại VGU.","Tổng điểm trung bình tiếng Anh ba năm ở bậc THPT đạt ít nhất 8,5."],"conditions":["Đạt danh hiệu học sinh giỏi ba năm ở bậc THPT trong năm tuyển sinh và đồng thời có: Chứng chỉ tiếng Anh quốc tế IELTS học thuật từ 6,0 trở lên hoặc tương đương."],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Xét TestAS","fields":{"audience":["Thí sinh làm bài thi Paper-based TestAS (làm bài thi trên giấy) được tổ chức tại VGU gồm một bài thi cơ bản (Core Test) và một bài thi kiến thức chuyên ngành (Subject-Specific Module)."],"conditions":["Điểm trúng tuyển: Kết quả tổng hợp của bài Paper-based TestAS từ 90 điểm trở lên."],"formula":[],"bonus":[],"quota":[],"notes":["Bài thi kiến thức khối chuyên ngành được quy định.","Đối với ngành CSE: Bài thi về Toán học, Khoa học máy tính và Khoa học tự nhiên.","Đối với các ngành ECE, MEN, SME, EPE, BCE, ARC, MEC: Bài thi về Kỹ thuật.","Đối với các ngành BFA, BBA, BSE: Bài thi về Kinh tế.","Kết quả tổng hợp của bài thi Paper-based TestAS được xác định từ kết quả của hai bài thi thành phần theo tỉ lệ: Core Test 40% và Subject-Specific Module 60%."]},"shared":false}],"common":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"timeline":[{"date":"01/6/2025 – 31/7/2025","event":"Nhận hồ sơ đăng ký xét tuyển"},{"date":"01/4/2025 – 30/06/2025","event":"Nhận hồ sơ đăng ký xét tuyển"},{"date":"04/5/2025","event":"Nhận hồ sơ đăng ký"},{"date":"24–25/5/2025","event":"Thi"}],"documents":["Học bạ THPT"],"post_id":28676,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-viet-duc","modified":"2025-12-19T08:33:32","school_name":"Trường Đại Học Việt Đức","province":"Thành phố Hồ Chí Minh","groups":["Kỹ thuật"],"taxonomy_years":["2025"],"method_tags":["TN THPT"]}}