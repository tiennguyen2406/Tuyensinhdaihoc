"Thiết kế đồ họa","major_code":"7210403","program_type":"CHUAN","combos":"","scores":{"KETHOP":{"score":20.0,"scale":30.0,"equiv":null}},"notes":["Kết hợp học bạ với điểm thi năng khiếu"]}],"tuition":{"uni_code":"DTL","year":2026,"min_mil":35.1,"max_mil":54.0,"unit_note":null,"text":"Tùy ngành","source_url":"https://tuyensinhso.vn/chua-phan-loai/hien-co-gan-120-truong-dai-hoc-cong-bo-hoc-phi-nam-2026-c430564.html","source_type":"aggregator","confidence":"medium"},"tuition_extra":null,"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-thang-long-DTL.html","dean":{"year":2026,"methods_year":2026,"quota":[],"methods":[{"name":"Điểm thi THPT","fields":{"audience":["Xét tuyển dựa theo kết quả kỳ thi tốt nghiệp THPT năm 2026.","Xét tuyển thí sinh có kết quả thi tốt nghiệp THPT năm 2026 đạt ngưỡng đảm bảo chất lượng đầu vào do Bộ Giáo dục và Đào tạo và Trường Đại học Thăng Long quy định."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Điểm thi THPT và CCQT","fields":{"audience":[],"conditions":[],"formula":["Thí sinh có tối thiểu một trong các chứng chỉ ngoại ngữ quốc tế (IELTS, TOEFL iBT, HSK+HSKK, JLPT, TOPIK II) có thể dùng để quy đổi sang điểm của môn Ngoại ngữ tương ứng trong tổ hợp xét tuyển."],"bonus":[],"quota":[],"notes":["Xét tuyển kết hợp kết quả thi tốt nghiệp THPT năm 2026 với chứng chỉ ngoại ngữ quốc tế.","Chứng chỉ còn hạn sử dụng tính theo quy định đến thời điểm xét tuyển.","Không xét tuyển với các chứng chỉ có hình thức thi “Home Edition”."]},"shared":false},{"name":"Điểm ĐGNL HN","fields":{"audience":[],"conditions":["Xét tuyển thí sinh có kết quả thi đánh giá năng lực ĐHQGHN năm 2025 và năm 2026 đạt ngưỡng đảm bảo chất lượng do Trường Đại học Thăng Long quy định."],"formula":["Điểm xét tuyển được tính theo công thức sau đây: Điểm xét tuyển = Kết quả thi HSA (quy đổi về thang 30) + Điểm cộng (nếu có) + Điểm ưu tiên (nếu có) ."],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Điểm Đánh giá Tư duy","fields":{"audience":[],"conditions":["Xét tuyển thí sinh có kết quả thi đánh giá tư duy năm 2025 và năm 2026 đạt ngưỡng đảm bảo chất lượng do Trường Đại học Thăng Long quy định."],"formula":["Điểm xét tuyển được tính theo công thức sau đây: Điểm xét tuyển = Kết quả thi TSA (quy đổi về thang 30) + Điểm cộng (nếu có) + Điểm ưu tiên (nếu có) ."],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Điểm ĐGNL ĐH Sư phạm HN","fields":{"audience":[],"conditions":["Xét tuyển thí sinh có kết quả thi đánh giá năng lực ĐH Sư phạm HN tổ chức năm 2026 đạt ngưỡng đảm bảo chất lượng do Trường Đại học Thăng Long quy định."],"formula":["Điểm xét tuyển được tính theo công thức sau đây: Điểm xét tuyển = Kết quả thi SPT (quy đổi về thang 30) + Điểm cộng (nếu có) + Điểm ưu tiên (nếu có) ."],"bonus":[],"quota":[],"notes":["Xét tuyển dựa theo kết quả thi đánh giá năng lực (HSA) do Đại học Quốc gia Hà Nội tổ chức hoặc kết quả thi đánh giá tư duy (TSA) do Đại học Bách khoa Hà Nội tổ chức hoặc kết quả thi đánh giá năng lực (SPT) do Trường Đại học Sư phạm Hà Nội…"]},"shared":false},{"name":"Xét tuyển kết hợp điểm tốt nghiệp THPT với học bạ","fields":{"audience":[],"conditions":["Điều kiện xét tuyển sẽ được Nhà trường cập nhật sau khi Bộ Giáo dục và Đào tạo ban hành Quy chế tuyển sinh."],"formula":["Xét tuyển kết quả học tập trung bình 3 năm học THPT theo tổ hợp xét tuyển và đáp ứng các điều kiện theo Quy chế tuyển sinh hiện hành của Bộ Giáo dục và Đào tạo và quy định của Trường Đại học Thăng Long.","Điểm xét tuyển được tính theo công thức sau đây: Điểm xét tuyển = M1 + M2 + M3 + Điểm cộng (nếu có) + Điểm ưu tiên (nếu có) .","M1, M2, M3 là điểm trung bình 3 năm học THPT của 3 môn học theo tổ hợp xét tuyển."],"bonus":[],"quota":[],"notes":["Xét tuyển kết hợp kết quả thi tốt nghiệp THPT với kết quả học tập cấp THPT (áp dụng đối với các ngành Điều dưỡng, Quản trị dịch vụ du lịch và lữ hành, Quản trị khách sạn)"]},"shared":false},{"name":"Xét kết hợp học bạ và điểm thi năng khiếu","fields":{"audience":[],"conditions":["Hạnh kiểm lớp 12 đạt loại khá trở lên.","Đối với ngành Thanh nhạc : Thí sinh bắt buộc phải thi 2 môn năng khiếu âm nhạc do Trường Đại học Thăng Long tổ chức và đáp ứng điều kiện điểm thi Âm nhạc 1 ≥ 8,0, điểm thi Âm nhạc 2 ≥ 5,0 trong kì thi năng khiếu âm nhạc."],"formula":["Xét tuyển thí sinh có kết quả học tập trung bình 3 năm học THPT kết hợp với kết quả thi năng khiếu theo tổ hợp xét tuyển.","Đối với ngành Thiết kế đồ hoạ : Môn Ngữ văn ≥ 5,0 (với tổ hợp H00)","Môn Ngữ văn và môn Toán ≥ 5,0 (với tổ hợp H01).","Điểm xét tuyển được tính theo công thức sau đây: * Đối với tổ hợp N00 , H00 : Điểm xét tuyển = Ngữ văn (trung bình 3 năm học THPT) + Năng khiếu 1 + Năng khiếu 2 + Điểm ưu tiên (nếu có)","Đối với tổ hợp H01 : Điểm xét tuyển = (Toán (trung bình 3 năm học THPT) + Ngữ văn (trung bình 3 năm học THPT) + Năng khiếu vẽ mỹ thuật × 2) × 3/4 + Điểm ưu tiên (nếu có) ."],"bonus":[],"quota":[],"notes":["Xét tuyển kết hợp kết quả học tập cấp THPT với điểm thi năng khiếu (áp dụng đối với ngành Thanh nhạc và Thiết kế đồ hoạ)","Về kết quả học tập trung bình 3 năm học THPT.","Đối với ngành Thanh nhạc : Môn Ngữ văn ≥ 5,0.","Đối với ngành Thiết kế đồ hoạ : Thí sinh bắt buộc thi 2 môn năng khiếu Vẽ mỹ thuật do Trường Đại học Thăng Long tổ chức hoặc các trường đại học có tổ chức kỳ thi năng khiếu mỹ thuật bao gồm: Trường Đại học Mỹ thuật Công nghiệp…"]},"shared":false},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Thí sinh đoạt giải nhất, nhì, ba trong kỳ thi chọn học sinh giỏi quốc gia, quốc tế hoặc thi khoa học, kỹ thuật cấp quốc gia, quốc tế do Bộ Giáo dục và Đào tạo tổ chức, cử tham gia.","Thời gian đoạt giải không quá 3 năm tính tới thời điểm xét tuyển thẳng.","Thí sinh đoạt giải chính thức trong các cuộc thi nghệ thuật quốc tế về ca, múa, nhạc, mỹ thuật được Bộ Văn hoá, Thể thao và Du lịch công nhận.","Thời gian đoạt giải không quá 4 năm tính tới thời điểm xét tuyển thẳng.","Đối với các thí sinh thuộc đối tượng quy định tại mục a nêu trên: Xét tuyển thẳng vào tất cả các ngành học của Trường Đại học Thăng Long, trừ ngành Thanh nhạc và Thiết kế đồ hoạ.","Đối với các thí sinh thuộc đối tượng quy định tại mục b nêu trên: Xét tuyển thẳng vào ngành phù hợp (Thanh nhạc hoặc Thiết kế đồ hoạ) với môn đoạt giải."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Xét tuyển thẳng (theo Quy chế tuyển sinh của Bộ Giáo dục và Đào tạo và theo quy định của Trường Đại học Thăng Long)"]},"shared":false}],"common":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"timeline":[],"documents":[],"post_id":28426,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-thang-long","modified":"2025-12-22T07:58:00","school_name":"Trường Đại Học Thăng Long","province":"Thành phố Hà Nội","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["HSA","TN THPT","TSA"]}}