cores":{"DGTD":{"score":56.17,"scale":100.0,"equiv":null}},"notes":[]},{"program_code":"ET1","program_name":"Kỹ thuật Điện tử-Viễn thông","major_code":"7520207","program_type":"CHUAN","combos":"","scores":{"KETHOP":{"score":86.01,"scale":100.0,"equiv":null}},"notes":["Xét tuyển tài năng"]}],"tuition":{"uni_code":"BKA","year":2026,"min_mil":28.0,"max_mil":68.0,"unit_note":null,"text":"Chương trình chuẩn 28–40 triệu/năm; giảng dạy bằng tiếng Anh, chất lượng cao 35–68 triệu/năm","source_url":"https://nhandan.vn/hoc-phi-dai-hoc-tang-theo-lo-trinh-tu-chu-post978685.html","source_type":"press","confidence":"high"},"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-bach-khoa-ha-noi-BKA.html","dean":{"year":2026,"methods_year":2026,"quota":["Tổng chỉ tiêu tuyển sinh đại học chính quy năm 2026 dự kiến là 9.880 sinh viên, với 3 phương thức tuyển sinh được duy trì như các năm trước."],"methods":[{"name":"Điểm thi THPT","fields":{"audience":["Thí sinh tham dự kỳ thi tốt nghiệp THPT năm 2026 do Bộ GD&ĐT và các Sở GD&ĐT tổ chức."],"conditions":[],"formula":["Tổ hợp xét tuyển: Gồm 8 tổ hợp xét tuyển và môn chính sau: K01, A00, A01, B00, D01, D04, D07 và DD2.","Công thức tính điểm xét tuyển đối với tổ hợp K01 như sau: [Toán × 3 + Ngữ văn × 1 + Lý/Hóa/Sinh/Tin × 2] × 1/2."],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Xét tuyển tài năng","fields":{"audience":["Thí sinh tốt nghiệp THPT năm 2026, đạt thành tích cao trong kỳ thi chọn học sinh giỏi (HSG), kỳ thi khoa học, kỹ thuật (KHKT) cấp quốc gia (ViSEF) hoặc quốc tế (ISEF) do Bộ Giáo dục và Đào tạo tổ chức hoặc cử tham gia.","Thời gian đạt giải không quá 3 năm tính tới thời điểm xét tuyển thẳng.","Thí sinh được triệu tập tham dự kỳ thi chọn đội tuyển Olympic hoặc đoạt giải Nhất, Nhì, Ba trong kỳ thi chọn HSG quốc gia các môn Toán, Lý, Hóa, Sinh, Tin, Ngoại ngữ được xét tuyển thẳng vào các ngành học phù hợp với môn đạt giải.","Thí sinh trong đội tuyển quốc gia tham dự kỳ thi KHKT quốc tế hoặc đạt giải Nhất, Nhì, Ba trong kỳ thi KHKT cấp quốc gia do Bộ GD&ĐT tổ chức được xét tuyển thẳng vào ngành học phù hợp với lĩnh vực đề tài đã đăng ký dự thi."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Điểm Đánh giá Tư duy","fields":{"audience":["Thí sinh tham dự kỳ thi Đánh giá tư duy (ĐGTD) năm 2025 hoặc 2026 do Đại học Bách khoa Hà Nội tổ chức."],"conditions":["Thí sinh đã tốt nghiệp THPT và đạt ngưỡng điểm thi theo quy định."],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Chứng chỉ quốc tế","fields":{"audience":["Xét tuyển theo chứng chỉ Quốc tế.","Có ít nhất 1 trong các chứng chỉ Quốc tế sau còn hiệu lực: SAT, ACT, A-Level, AP, IB."],"conditions":["Thí sinh có điểm trung bình chung (TBC) các môn văn hóa từng năm học lớp 10, 11, 12 đạt từ 8,00 trở lên theo thang điểm 10."],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Hồ sơ năng lực kết hợp phỏng vấn","fields":{"audience":["Đạt giải trong kỳ thi chọn HSG quốc gia do Bộ Giáo dục và Đào tạo tổ chức hoặc kỳ thi chọn HSG cấp tỉnh/thành phố do các Sở GDĐT, Đại học Quốc gia Hà Nội, Đại học Quốc gia thành phố Hồ Chí Minh, Đại học Huế, Trường Đại học Sư phạm Hà Nội…","Đạt giải Ba trở lên cuộc thi KHKT do Sở GDĐT hoặc Bộ GDĐT chủ trì tổ chức để lựa chọn đi dự thi ViSEF và ISEF.","Được chọn tham dự cuộc thi Đường lên đỉnh Olympia do Đài Truyền hình Việt Nam tổ chức từ vòng thi tháng trở lên.","Học sinh hệ chuyên trong cả 3 năm học lớp 10, 11, 12 (gồm chuyên Toán, Lý, Hóa, Sinh, Tin học, Ngoại ngữ) của các trường THPT và THPT chuyên trên toàn quốc, các lớp chuyên, hệ chuyên thuộc các Trường đại học, Đại học quốc gia, Đại học vùng."],"conditions":["Thí sinh tốt nghiệp THPT năm 2026, có điểm TBC các môn văn hóa từng năm học lớp 10, 11, 12 đạt từ 8,00 trở lên theo thang điểm 10 và đáp ứng một trong những điều kiện sau."],"formula":["Quy định về tính điểm hồ sơ năng lực của thí sinh: Điểm hồ sơ năng lực (HSNL) của thí sinh được tính như sau (tối đa 100 điểm)","Điểm HSNL = Điểm tư duy + Điểm thành tích + Điểm thưởng.","Điểm tư duy (tối đa 40 điểm): Điểm tư duy được tính dựa trên điểm thi Đánh giá tư duy (TSA) của thí sinh trong năm 2025 hoặc 2026 và được tính theo công thức là điểm TSA × 40/60.","Điểm thành tích (tối đa 50 điểm): Điểm thành tích của thí sinh được tính dựa trên tổng điểm các thành tích hợp lệ mà thí sinh đạt được và kê khai trên hệ thống."],"bonus":["Điểm thưởng (tối đa 10 điểm): Điểm thưởng của thí sinh được tính cho các thành tích khác về học tập, nghiên cứu khoa học chưa được tính trong điểm thành tích."],"quota":[],"notes":["Chứng chỉ Ngoại ngữ.","Các giải thưởng về văn hóa, văn nghệ, thể dục, thể thao (các giải thưởng về văn – thể – mỹ)","Các khen thưởng về hoạt động xã hội, tình nguyện vì cộng đồng do thí sinh kê khai hợp lệ trên hệ thống."]},"shared":true}],"common":{"audience":[],"conditions":["Có chứng chỉ tiếng Anh VSTEP trình độ B1 trở lên.","Có chứng chỉ IELTS (academic) đạt 5,0 trở lên hoặc tương đương.","Có điểm thi tốt nghiệp THPT năm 2026 môn tiếng Anh đạt từ 6,5 điểm trở lên."],"formula":[],"bonus":["Thí sinh có chứng chỉ Ngoại ngữ, có đăng ký xác thực trên hệ thống của ĐHBK Hà Nội có thể quy đổi thành điểm môn tiếng Anh khi xét tuyển theo điểm thi tốt nghiệp THPT (tổ hợp A01, D01, D07) và cộng điểm thưởng khi xét tuyển theo phương…"],"quota":[],"notes":["Đối với thí sinh đăng ký xét tuyển vào các chương trình giảng dạy bằng tiếng Anh, các chương trình FL1 (Tiếng Anh KHKT và Công nghệ), FL3 (Tiếng Trung KH&CN) và FL4 (Tiếng Hàn KH&CN)…","Đối với thí sinh đăng ký xét tuyển vào các chương trình liên kết đào tạo quốc tế bao gồm TROY-IT và FL2 (Tiếng Anh chuyên nghiệp quốc tế)…"]},"timeline":[{"date":"24–25/01/2026","event":"Đợt 1: Thi"},{"date":"05–15/12/2025","event":"Đợt 1: Đăng ký"},{"date":"14–15/03/2026","event":"Đợt 2: Thi"},{"date":"05–15/02/2026","event":"Đợt 2: Đăng ký"},{"date":"16–17/05/2026","event":"Đợt 3: Thi"},{"date":"05–15/04/2026","event":"Đợt 3: Đăng ký"}],"documents":[],"post_id":28342,"source_url":"https://huongnghiep.hocmai.vn/de-an/dai-hoc-bach-khoa-ha-noi","modified":"2025-12-22T04:15:25","school_name":"Đại Học Bách Khoa Hà Nội","province":"Thành phố Hà Nội","groups":["Kỹ thuật"],"taxonomy_years":["2025"],"method_tags":["TN THPT","TSA"]}}