yển thẳng, ưu tiên xét tuyển.","1 Bản photo công chứng Giấy chứng nhận đoạt giải trong các kỳ thi (nếu có) hoặc Giấy xác nhận là thành viên chính thức của đội tuyển tham dự các kỳ thi (nếu có)."]},"shared":true}],"common":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Hồ sơ đăng ký xét tuyển.","1 Bản photo công chứng Học bạ THPT/GDTX đủ 3 năm học.","1 Bản photo công chứng căn cước công dân (hai mặt).","1 Bản photo công chứng bằng tốt nghiệp THPT (Chỉ áp dụng đối với thí sinh tốt nghiệp trước năm 2025).","Lệ phí xét tuyển : 50.000đ/hồ sơ."]},"timeline":[],"documents":[],"post_id":28662,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-dai-nam","modified":"2025-12-19T08:30:49","school_name":"Trường Đại Học Đại Nam","province":"Thành phố Hà Nội","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["TN THPT"]}}