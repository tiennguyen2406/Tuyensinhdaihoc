,"scores":{"THPT":{"score":14.0,"scale":30.0,"equiv":null},"HOCBA":{"score":15.0,"scale":30.0,"equiv":null},"DGNL_HCM":{"score":580.0,"scale":1200.0,"equiv":14.0}},"notes":[]}],"tuition":null,"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-quang-nam-DQU.html","dean":{"year":2025,"methods_year":2025,"quota":["Năm 2025, Đại Học Quảng Nam dự kiến tuyển sinh 1.170 chỉ tiêu với các phương thức khác nhau cho nhóm ngành sư phạm, cho ngành Giáo dục mầm non và nhóm ngành còn lại."],"methods":[{"name":"Điểm thi THPT","fields":{"audience":["Phương thức (100): Xét điểm thi THPT năm 2025.","Thí sinh xét tuyển vào ngành sư phạm.","Thí sinh xét tuyển vào ngành ngoài sư phạm và ngành Giáo dục Mầm non.","Phương thức (405): Xét điểm thi THPT năm 2025 kết hợp với điểm thi năng khiếu.","Thí sinh xét tuyển vào ngành giáo dục mầm non."],"conditions":["Ngưỡng đảm bảo chất lượng đầu vào sẽ được công bố sau khi có kết quả thi tốt nghiệp THPT năm 2025 và theo quy định của Bộ Giáo dục và Đào tạo.","Ngành Giáo dục Mầm non: Theo quy định của Bộ GD&ĐT và điểm các môn Năng khiếu ≥5.","Đối với nhóm ngành còn lại: Công bố sau khi có kết quả thi tốt nghiệp THPT năm 2025."],"formula":[],"bonus":["Là tổng điểm 3 môn trong kỳ thi tốt nghiệp THPT theo thang điểm 10 đối với từng môn thi của từng tổ hợp môn đăng ký xét tuyển và cộng với điểm ưu tiên (quy đổi) nếu có theo quy chế hiện hành."],"quota":[],"notes":[]},"shared":true},{"name":"Điểm học bạ","fields":{"audience":["Phương thức (200): Xét điểm học bạ lớp 12 năm 2025.","Thí sinh xét tuyển vào ngành sư phạm.","Thí sinh xét tuyển vào ngành ngoài sư phạm và ngành Giáo dục Mầm non.","Phương thức (502): Xét điểm học bạ THPT tốt nghiệp trước năm 2025.","Phương thức (406): Xét điểm học bạ THPT tốt nghiệp năm 2025 kết hợp với điểm thi năng khiếu.","Thí sinh xét tuyển vào ngành giáo dục mầm non."],"conditions":["Đối với các ngành đào tạo giáo viên: Học sinh đã tốt nghiệp THPT phải có học lực lớp 12 đạt loại Giỏi.","Ngành Giáo dục Mầm non: Học lực lớp 12 đạt loại Giỏi thì phải có điểm thi môn năng khiếu ≥ 5."],"formula":["Các ngành còn lại: Đã tốt nghiệp THPT và có tổng điểm 3 môn theo tổ hợp môn >=15,0."],"bonus":["Là tổng điểm 3 môn lớp 12 trong học bạ theo thang điểm 10 đối với từng môn thi của từng tổ hợp môn đăng ký xét tuyển và cộng với điểm ưu tiên (quy đổi) nếu có theo quy chế hiện hành."],"quota":[],"notes":[]},"shared":true},{"name":"Điểm ĐGNL HCM","fields":{"audience":["Phương thức (402): Xét tuyển theo kết quả thi đánh giá năng lực của Đại học Quốc gia TPHCM năm 2025.","Thí sinh xét tuyển vào ngành sư phạm.","Thí sinh xét tuyển vào ngành ngoài sư phạm và ngành Giáo dục Mầm non."],"conditions":["Đối với nhóm ngành đào tạo giáo viên: Xếp loại học lực lớp 12 đạt loại Giỏi.","Các ngành còn lại: Có tổng điểm bài thi ĐGNL từ 600 điểm trở lên."],"formula":["Điểm xét tuyển = Điểm đạt * 30/1200 + Điểm ưu tiên (quy đổi) nếu có theo Quy chế tuyển sinh hiện hành.","Đối với phương thức xét theo kết quả thi ĐGNL cho ngành GD Mầm non: Điểm xét tuyển = Điểm đạt* 20/1200 + Điểm TBC (năng khiếu) + Điểm ưu tiên (quy đổi) nếu có theo Quy chế tuyển sinh hiện hành."],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Phương thức (301): Xét tuyển thẳng theo quy định của Quy chế tuyển sinh.","Thí sinh xét tuyển vào ngành sư phạm.","Thí sinh xét tuyển vào ngành ngoài sư phạm và ngành Giáo dục Mầm non."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false}],"common":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Phạm vi tuyển sinh.","Các ngành sư phạm chỉ tuyển thí sinh có hộ khẩu thường trú tại tỉnh Quảng Nam.","Các ngành ngoài sư phạm tuyển sinh trong cả nước.","Điểm xét tuyển."]},"timeline":[{"date":"01/9/2025 – 31/9/2025","event":"Đợt 1: Bổ sung"},{"date":"1/10/2025 – 31/12/2025","event":"Đợt 2: Bổ sung"}],"documents":["Học bạ THPT"],"post_id":28572,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-quang-nam","modified":"2025-12-19T08:10:38","school_name":"Trường Đại Học Quảng Nam","province":"Thành phố Đà Nẵng","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["TN THPT","VACT"]}}