ore":81.25,"scale":150.0,"equiv":null},"DGTD":{"score":57.5,"scale":100.0,"equiv":null}},"notes":[]},{"program_code":"7810201DKD","program_name":"Quản trị khách sạn (CS Nam Định)","major_code":"7810201","program_type":"CHUAN","combos":"C00;C01;C03;C04;C07;C09;D01;D11;D14;D15;X01;X70;X74;X78;X79;X80","scores":{"THPT":{"score":23.5,"scale":30.0,"equiv":null},"HOCBA":{"score":26.313,"scale":30.0,"equiv":null},"DGNL_HN":{"score":75.625,"scale":150.0,"equiv":null},"DGTD":{"score":53.75,"scale":100.0,"equiv":null}},"notes":[]},{"program_code":"7810201DKK","program_name":"Quản trị khách sạn (CS Hà Nội)","major_code":"7810201","program_type":"CHUAN","combos":"C00;C01;C03;C04;C07;C09;D01;D11;D14;D15;X01;X70;X74;X78;X79;X80","scores":{"THPT":{"score":24.5,"scale":30.0,"equiv":null},"HOCBA":{"score":27.188,"scale":30.0,"equiv":null},"DGNL_HN":{"score":79.375,"scale":150.0,"equiv":null},"DGTD":{"score":56.25,"scale":100.0,"equiv":null}},"notes":[]}],"tuition":null,"tuition_extra":{"uni_code":"DKK","name":"Trường Đại học Kinh tế - Kỹ thuật Công nghiệp","school_year":"2025–2026","year_start":2025,"scope":"2025–2026, tham khảo","summary":"Khoảng 600.000 đ/tín chỉ","items":[],"flags":["theo_tin_chi"],"only_major":null,"evidence":"secondary","note":"Chưa xác minh mức 2026. Chưa đủ bằng chứng để xác nhận đây là đơn giá chính thức theo từng ngành/khóa.","sources":["https://cellphones.com.vn/sforum/hoc-phi-dai-hoc-kinh-te-ky-thuat-cong-nghiep","https://uneti.edu.vn/wp-content/uploads/2026/08/5.-Thong-bao-thu-hoc-phi-hoc-ki-1-nam-hoc-2026-2027.docx"],"auto_ok":true},"source_url":"https://diemthi.tuyensinh247.com/diem-chuan/dai-hoc-kinh-te-ky-thuat-cong-nghiep-DKK.html","dean":{"year":2025,"methods_year":2025,"quota":[],"methods":[{"name":"Điểm thi THPT","fields":{"audience":["Thí sinh tham dự thi kỳ thi tốt nghiệp THPT năm 2025 và có đăng ký sử dụng kết quả để xét tuyển đại học.","Đủ điều kiện tốt nghiệp THPT theo quy định.","Đạt ngưỡng điểm xét tuyển tối thiểu do Nhà Trường quy định."],"conditions":["Đối với ngành Ngôn ngữ Anh, điểm môn Tiếng Anh trong tổ hợp xét tuyển tối thiểu đạt từ 6,00 điểm trở lên."],"formula":["Điểm xét tuyển: ĐXT = (ĐPT2QĐ + KK) + UT.","ĐPT2QĐ = (M1 × 5 + M2 × 3 + M3 × 2) × 3/10.","M1, M2, M3 là kết quả điểm thi tốt nghiệp THPT năm 2025 của các môn thi trong tổ hợp xét tuyển."],"bonus":["(Điểm xét tuyển không lớn hơn 30 điểm bao gồm cả điểm ưu tiên, điểm khuyến khích)"],"quota":[],"notes":[]},"shared":true},{"name":"Điểm học bạ","fields":{"audience":["Thí sinh đã tốt nghiệp THPT hoặc tương đương.","Đạt ngưỡng điểm xét tuyển tối thiểu do Nhà Trường quy định."],"conditions":["Đối với ngành Ngôn ngữ Anh điểm tổng kết các học kỳ xét tuyển môn Tiếng Anh đạt 7,00 điểm trở lên.","Thí sinh đã tốt nghiệp THPT hoặc tương đương.","Đạt ngưỡng điểm xét tuyển tối thiểu do Nhà Trường quy định.","Đối với ngành Ngôn ngữ anh điểm tổng kết các học kỳ xét tuyển môn tiếng anh đạt 7,00 điểm trở lên."],"formula":["Xác định điểm xét tuyển: ĐXT = (ĐPT3QĐ + KK) + UT.","ĐPT3QĐ: Là điểm quy đổi từ điểm phương thức 3 (ĐPT3) theo quy tắc quy đổi tương đương được Nhà trường công bố muộn nhất cùng thời gian công bố ngưỡng bảo đảm chất lượng đầu vào.","ĐPT3 = (M1 × 5 + M2 × 3 + M3 × 2) × 3/10.","M1, M2, M3: Điểm tổng kết cả năm lớp 12 của các môn trong tổ hợp xét tuyển."],"bonus":[],"quota":[],"notes":["1 Phiếu đăng ký xét tuyển theo mẫu của Nhà trường (thí sinh lấy trên website: www.uneti.edu.vn hoặc in trực tiếp khi thí sinh đăng ký xét tuyển trực tuyến trên cổng: https://xettuyen.uneti.edu.vn/dang-ky-xet-tuyen-hoc-ba.html)"]},"shared":true},{"name":"Điểm Đánh giá Tư duy","fields":{"audience":["Thí sinh có kết quả thi kỳ thi đánh giá tư duy do Đại học Bách khoa Hà Nội tổ chức trong thời gian không quá 2 năm.","Đủ điều kiện tốt nghiệp THPT theo quy định."],"conditions":[],"formula":["Xác định điểm xét tuyển: ĐXT = (ĐPT4QĐ + KK) + UT.","ĐPT4QĐ: Là điểm quy đổi từ điểm phương thức 4 (ĐPT4) theo quy tắc quy đổi tương đương được Nhà trường công bố muộn nhất cùng thời gian công bố ngưỡng bảo đảm chất lượng đầu vào.","ĐPT4 = Tổng điểm bài thi đánh giá tư duy."],"bonus":[],"quota":[],"notes":["1 bản sao công chứng Giấy chứng nhận kết quả thi đánh giá tư duy của Đại học Bách khoa Hà Nội.","Giấy chứng nhận ưu tiên (nếu có)"]},"shared":true},{"name":"Điểm ĐGNL HN","fields":{"audience":["Thí sinh tham dự thi kỳ thi đánh giá năng lực năm 2025 do Đại học Quốc gia Hà Nội tổ chức.","Đủ điều kiện tốt nghiệp THPT theo quy định."],"conditions":[],"formula":["Điểm xét tuyển: ĐXT = (ĐPT5QĐ + KK) + UT.","ĐPT5QĐ: Là điểm quy đổi từ điểm phương thức 5 (ĐPT5) theo quy tắc quy đổi tương đương được Nhà trường công bố muộn nhất cùng thời gian công bố ngưỡng bảo đảm chất lượng đầu vào.","ĐPT5 = Tổng điểm tổ hợp cao nhất bài thi đánh giá năng lực."],"bonus":[],"quota":[],"notes":["1 bản sao công chứng Giấy chứng nhận kết quả thi đánh giá năng lực của Đại học Quốc gia Hà Nội.","Giấy chứng nhận ưu tiên (nếu có)."]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Xét tuyển thẳng.","Nhà trường xét tuyển thẳng đối với những thí sinh thuộc các đối tượng được quy định cụ thể tại điều 8 Quy chế tuyển sinh đại học được ban hành kèm theo Quyết định số 951/QĐ-ĐHKTKTCN ngày 19 tháng 12 năm 2022 của Hiệu trưởng Trường Đại học…"],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false}],"common":{"audience":[],"conditions":[],"formula":["ĐXT: Là điểm xét tuyển.","Thí sinh có thể sử dụng Chứng chỉ Tiếng Anh Quốc tế để quy đổi điểm thay thế môn Tiếng Anh trong tổ hợp xét tuyển của phương thức xét điểm thi tốt nghiệp THPT và xét kết quả học tập bậc THPT."],"bonus":["KK: Là điểm khuyến khích đối với thí sinh có chứng chỉ tiếng Anh quốc tế và điểm ưu tiên cho thí sinh đăng ký xét tuyển tại cơ sở Nam Định.","UT: Là điểm ưu tiên khu vực và điểm ưu tiên đối tượng theo Quy chế tuyển sinh của Bộ GD&ĐT.","Cộng điểm khuyến khích cho tất cả thí sinh có chứng chỉ Tiếng Anh Quốc tế đăng ký xét tuyển vào trường Đại học Kinh tế – Kỹ thuật Công nghiệp."],"quota":[],"notes":["1 Phiếu đăng ký xét tuyển phương thức đánh giá năng lực theo mẫu của Nhà trường (thí sinh tải mẫu phiếu đăng ký xét tuyển trên website: www.uneti.edu.vn)","1 bản sao công chứng Bằng tốt nghiệp THPT đối với thí sinh tốt nghiệp trước năm 2025 hoặc giấy chứng nhận tốt nghiệp tạm thời đối với học sinh tốt nghiệp năm 2025.","1 bản sao công chứng Chứng minh thư nhân dân hoặc Căn cước công dân."]},"timeline":[],"documents":["1 bản sao công chứng Học bạ THPT","1 bản sao công chứng Chứng minh thư nhân dân hoặc Căn cước công dân","1 bản sao công chứng Giấy chứng nhận kết quả thi đánh giá tư duy của Đại học Bách khoa Hà Nội","Giấy chứng nhận ưu tiên (nếu có)","1 bản sao công chứng Giấy chứng nhận kết quả thi đánh giá năng lực của Đại học Quốc gia Hà Nội","Lệ phí xét tuyển:"],"post_id":28392,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-kinh-te-ky-thuat-cong-nghiep","modified":"2025-12-22T07:51:05","school_name":"Trường Đại Học Kinh Tế Kỹ Thuật Công Nghiệp","province":"Thành phố Hà Nội","groups":["Kỹ thuật"],"taxonomy_years":["2025"],"method_tags":["HSA","TN THPT","TSA"]}}