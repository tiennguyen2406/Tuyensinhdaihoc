inh247.com/diem-chuan/dai-hoc-dai-nam-DDN.html","dean":{"year":2026,"methods_year":2025,"quota":[],"methods":[{"name":"Điểm thi THPT","fields":{"audience":[],"conditions":["Ngưỡng đảm bảo chất lượng (điểm sàn) của Phương thức 1: Điểm xét tuyển đạt mức điểm sàn do Trường quy định sau khi có kết quả thi tốt nghiệp THPT năm 2025, riêng Khối ngành Sức khỏe do Bộ GD&ĐT quy định."],"formula":["Xét điểm thi tốt nghiệp THPT 2025 của 3 môn trong tổ hợp xét tuyển.","Điểm xét tuyển = (Điểm môn 1 + Điểm môn 2 + Điểm môn 3) + Điểm ƯT (nếu có)."],"bonus":["Điểm ưu tiên: Điểm ưu tiên khu vực và đối tượng (theo Quy chế tuyển sinh hiện hành)."],"quota":[],"notes":[]},"shared":false},{"name":"Điểm học bạ","fields":{"audience":[],"conditions":["Tổng điểm trung bình của 3 môn trong tổ hợp xét tuyển vào ngành học: Ngành Y khoa, Dược học ≥ 24 điểm và có học lực năm lớp 12 đạt loại Giỏi.","Ngành Điều dưỡng ≥ 19,5 điểm và có học lực năm lớp 12 đạt từ loại Khá trở lên.","Các ngành còn lại ≥ 18 điểm."],"formula":["Xét điểm học bạ cả năm lớp 12 THPT của 3 môn trong tổ hợp xét tuyển.","Điểm xét tuyển = (Điểm môn 1 + Điểm môn 2 + Điểm môn 3)","Điểm môn 1 = Điểm trung bình cả năm lớp 12 của môn 1.","Điểm môn 2 = Điểm trung bình cả năm lớp 12 của môn 2.","Điểm môn 3 = Điểm trung bình cả năm lớp 12 của môn 3."],"bonus":[],"quota":[],"notes":["Nhà trường không cộng điểm ưu tiên đối với phương thức xét học bạ.","1 Phiếu đăng ký xét tuyển theo mẫu của Đại học Đại Nam."]},"shared":true},{"name":"ƯTXT, XT thẳng","fields":{"audience":["Tuyển thẳng thí sinh đạt các yêu cầu về xét tuyển thẳng theo quy định của Bộ GD&ĐT và Trường Đại học Đại Nam."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["1 Phiếu đăng ký xét tuyển thẳng, ưu tiên xét tuyển.","1 Bản photo công chứng Giấy chứng nhận đoạt giải trong các kỳ thi (nếu có) hoặc Giấy xác nhận là thành viên chính thức của đội tuyển tham dự các kỳ thi (nếu có)."]},"shared":true}],"common":{"audience":[],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":["Hồ sơ đăng ký xét tuyển.","1 Bản photo công chứng Học bạ THPT/GDTX đủ 3 năm học.","1 Bản photo công chứng căn cước công dân (hai mặt).","1 Bản photo công chứng bằng tốt nghiệp THPT (Chỉ áp dụng đối với thí sinh tốt nghiệp trước năm 2025).","Lệ phí xét tuyển : 50.000đ/hồ sơ."]},"timeline":[],"documents":[],"post_id":28662,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-dai-nam","modified":"2025-12-19T08:30:49","school_name":"Trường Đại Học Đại Nam","province":"Thành phố Hà Nội","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["TN THPT"]}}