gành, lấy điểm từ cao xuống thấp cho đến hết chỉ tiêu, không phân biệt thứ tự NV giữa các thí sinh.","Nếu xét tuyển cho mỗi đối tượng chưa đủ chỉ tiêu, chỉ tiêu còn lại chuyển sang cho đối tượng khác.","Quá thời hạn này, thí sinh không xác nhận nhập học được xem như từ chối nhập học và kết quả trúng tuyển sẽ bị hủy để chuyển chỉ tiêu cho đối tượng khác."]},"shared":true},{"name":"Điểm học bạ","fields":{"audience":[],"conditions":[],"formula":["Xét tuyển dựa trên tổ hợp các môn học ở THPT, xét tuyển học sinh đã tốt nghiệp THPT phải có học lực lớp 12 xếp loại giỏi hoặc điểm xét tốt nghiệp THPT từ 8,0 trở lên.","Xét tuyển dựa vào kết quả học tập lớp 12 THPT: điểm trung bình cộng của các môn học thuộc tổ hợp môn xét tuyển không nhỏ hơn 6,0."],"bonus":[],"quota":[],"notes":["Đối với ngành đào tạo thuộc nhóm ngành đào tạo giáo viên ở các trình độ đại học, cao đẳng.","Đối với các ngành khác."]},"shared":true},{"name":"Xét tuyển thí sinh tốt nghiệp THPT nước ngoài","fields":{"audience":[],"conditions":["Văn bằng tốt nghiệp tối thiểu tương đương văn bằng tốt nghiệp THPT của Việt Nam theo quy định pháp luật của Việt Nam hoặc các điều ước quốc tế mà Việt Nam và nước gửi lưu học sinh là thành viên đối với từng cấp học và trình độ đào tạo.","Lưu học sinh phải có đủ sức khỏe để học tập tại Việt Nam."],"formula":[],"bonus":[],"quota":[],"notes":["Có chứng nhận Tiếng Việt hoặc đã tốt nghiệp các cấp học ở giáo dục phổ thông, trung cấp, cao đẳng, đại học, thạc sĩ và tiến sĩ bằng tiếng Việt hoặc hoàn thành chương trình dự bị tiếng Việt."]},"shared":false},{"name":"Điểm ĐGNL HN","fields":{"audience":["Thí sinh có điểm thi Đánh giá năng lực của ĐHQG HN."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":true},{"name":"Điểm ĐGNL HCM","fields":{"audience":["Thí sinh có điểm thi Đánh giá năng lực của ĐHQG TPHCM."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Điểm Đánh giá Tư duy","fields":{"audience":["Thí sinh có điểm thi Đánh giá Tư duy của ĐHBKHN."],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false},{"name":"Kết hợp điểm thi THPT với CCQT","fields":{"audience":["Kết hợp kết quả thi tốt nghiệp THPT với chứng chỉ quốc tế để xét tuyển (Chứng chỉ IELTS) (Mã 409)"],"conditions":[],"formula":[],"bonus":[],"quota":[],"notes":[]},"shared":false}],"common":{"audience":[],"conditions":["Ngưỡng đảm bảo chất lượng.","Xét tuyển dựa vào kết quả của kỳ thi tốt nghiệp THPT năm 2025, căn cứ ngưỡng đảm bảo chất lượng đầu vào của Bộ GD-ĐT…","Xét tuyển dựa trên tổ hợp các môn học ở THPT, xét tuyển học sinh đã tốt nghiệp THPT phải có học lực lớp 12 xếp loại giỏi hoặc điểm xét tốt nghiệp THPT từ 8,0 trở lên.","Đối với các PTXT khác điểm xét tuyển không thấp hơn ngưỡng đảm bảo chất lượng đầu vào của Bộ GD-ĐT (xét tuyển dựa vào kết quả của kỳ thi tốt nghiệp THPT)."],"formula":[],"bonus":[],"quota":[],"notes":[]},"timeline":[{"date":"01/3/2025 – 31/12/2025","event":"Nhận hồ sơ"}],"documents":["Phiếu đăng ký xét tuyển","Bản sao có công chứng học bạ THPT","Bản sao có công chứng bằng tốt nghiệp hoặc giấy chứng nhận tốt nghiệp THPT tạm thời (đối với thí sinh thi tốt nghiệp năm 2025)","Giấy chứng nhận kết quả thi tốt nghiệp THPT 2025","Bản sao có công chứng bằng tốt nghiệp THPT hoặc giấy chứng nhận tốt nghiệp THPT tạm thời (đối với thí sinh thi tốt nghiệp năm 2025)","Phiếu đăng ký xét tuyển (Phụ lục 2)"],"post_id":28562,"source_url":"https://huongnghiep.hocmai.vn/de-an/truong-dai-hoc-ha-tinh","modified":"2025-12-19T08:08:57","school_name":"Trường Đại Học Hà Tĩnh","province":"Khác","groups":["Kinh tế"],"taxonomy_years":["2025"],"method_tags":["HSA","TN THPT","TSA","VACT"]}}